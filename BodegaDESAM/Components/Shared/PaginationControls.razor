@using BodegaDESAM.Services

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-3 p-2">
    <div class="d-flex align-items-center gap-2 small text-muted">
        <label for="@SizeId">Mostrar</label>
        <select id="@SizeId" class="form-select form-select-sm pagination-size" value="@PageSize" @onchange="OnPageSizeChangedAsync" aria-label="Cantidad por página">
            @foreach (var size in PageSizes)
            {
                <option value="@size">@size</option>
            }
        </select>
        <span>por página · @TotalItems registro(s)</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(Page <= 1)" @onclick="() => PageChanged.InvokeAsync(Page - 1)">Anterior</button>
        <span class="small text-muted">Página @Page de @TotalPages</span>
        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(Page >= TotalPages)" @onclick="() => PageChanged.InvokeAsync(Page + 1)">Siguiente</button>
    </div>
</div>

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public int PageSize { get; set; } = PaginationDefaults.DefaultPageSize;
    [Parameter] public IReadOnlyList<int> PageSizes { get; set; } = PaginationDefaults.AllowedPageSizes;
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    private string SizeId { get; } = $"page-size-{Guid.NewGuid():N}";

    private async Task OnPageSizeChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var size))
            await PageSizeChanged.InvokeAsync(size);
    }
}
