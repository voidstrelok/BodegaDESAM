@page "/categorias-producto/nuevo"
@page "/categorias-producto/editar/{Id:long}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.AdminOrBodega)]

@using BodegaDESAM.Services

@inject CategoriaProductoService Service
@inject NavigationManager Nav

<h3 class="page-title mb-3">@Titulo</h3>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<EditForm Model="categoria" OnValidSubmit="Guardar" FormName="EditarCategoriaProducto">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="card-section p-3 mb-3">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label">Nombre</label>
                <InputText class="form-control" @bind-Value="categoria.Nombre" />
                <ValidationMessage For="@(() => categoria.Nombre)" />
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@busy">
            @if (busy)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                <span>Guardando...</span>
            }
            else
            {
                <span>Guardar</span>
            }
        </button>
        <button type="button" class="btn btn-secondary" @onclick="Volver" disabled="@busy">Cancelar</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public long? Id { get; set; }

    [SupplyParameterFromForm]
    CategoriaProducto categoria { get; set; } = new();

    bool busy;
    string? error;

    string Titulo => Id == null ? "Nueva Categoría" : "Editar Categoría";

    protected override async Task OnInitializedAsync()
    {
        if (Id != null)
        {
            var existente = await Service.GetByIdAsync((long)Id);
            if (existente != null)
                categoria = existente;
        }
    }

    async Task Guardar()
    {
        error = null;
        busy = true;

        try
        {
            if (Id == null)
                await Service.CreateAsync(categoria);
            else
                await Service.UpdateAsync(categoria);

            Nav.NavigateTo("/categorias-producto");
        }
        catch
        {
            error = "No se pudo guardar la categoría.";
        }
        finally
        {
            busy = false;
        }
    }

    void Volver() => Nav.NavigateTo("/categorias-producto");
}
