@page "/salidas/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.Public)]

@using BodegaDESAM.Services
@inject SalidaService SalidaService
@inject UserDisplayNameService UserDisplayNameService
@inject ProductoSerieService ProductoSerieService
@inject NavigationManager Nav

@if (salida == null) { <p>Cargando...</p> }
else
{
    <div class="detail-header"><div class="d-flex align-items-center gap-2"><button class="btn btn-outline-secondary btn-sm" @onclick="Volver"><i class="bi bi-arrow-left"></i><span class="visually-hidden">Volver</span></button><div><span class="movement-kind">Salida</span><h3 class="page-title m-0">Detalle #@salida.Id</h3></div></div><div class="detail-header-actions"><a class="btn btn-outline-info" target="_blank" href="@($"/reports/salidas/{salida.Id}.pdf")"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a><AuthorizeView Roles="@BodegaDESAM.Auth.AppRoles.AdminOrBodega"><Authorized><button class="btn btn-primary" @onclick="Editar"><i class="bi bi-pencil me-1"></i>Editar</button></Authorized></AuthorizeView></div></div>
    <section class="card-section detail-summary"><h5>Información general</h5><dl class="detail-grid"><div><dt>Fecha</dt><dd>@salida.Fecha.ToString("dd/MM/yyyy")</dd></div><div><dt>Bodega</dt><dd>@salida.Bodega.Nombre</dd></div><div><dt>Establecimiento</dt><dd>@salida.EStablecimiento.Nombre</dd></div><div><dt>Solicitante</dt><dd>@salida.Solicitante</dd></div><div><dt>Registrado por</dt><dd>@(usuario ?? "Usuario no disponible")</dd></div></dl>@if (!string.IsNullOrWhiteSpace(salida.Observacion)) { <div class="detail-observation"><span>Observación</span><p>@salida.Observacion</p></div> }</section>
    <section class="card-section detail-items"><div class="detail-section-heading"><div><h5 class="mb-0">Productos despachados</h5><span class="text-muted small">@salida.DetalleSalida.Count ítem(s)</span></div></div><div class="table-responsive d-none d-md-block"><table class="table table-hover align-middle mb-0"><thead><tr><th>Producto</th><th>Marca / modelo</th><th>Origen</th><th>Series</th><th class="text-end">Cantidad</th></tr></thead><tbody>@foreach (var d in salida.DetalleSalida) { <tr><td><div class="fw-semibold">@d.Producto.Nombre</div><div class="small text-muted">@d.Producto.CategoriaProducto?.Nombre</div></td><td><div>@d.Marca?.Nombre</div>@if (d.Modelo != null) { <div class="small text-muted">@d.Modelo.Nombre</div> }</td><td>@if (d.DetalleEntrada?.Entrada != null) { <a href="@($"/entradas/{d.DetalleEntrada.Entrada.Id}")">Entrada #@d.DetalleEntrada.Entrada.Id</a><div class="small text-muted">@d.DetalleEntrada.Entrada.NDocumento</div> } else if (d.DetalleAjusteOrigen?.Ajuste != null) { <a href="@($"/ajustes/{d.DetalleAjusteOrigen.Ajuste.Id}")">Ajuste #@d.DetalleAjusteOrigen.Ajuste.Id</a> } else { <span class="text-muted">—</span> }</td><td class="series-cell">@(seriesPorProducto.TryGetValue(d.id_producto, out var series) && series.Count > 0 ? string.Join(", ", series) : "Sin serie")</td><td class="text-end fw-semibold">@d.Cantidad</td></tr> }</tbody></table></div><div class="detail-item-cards d-md-none">@foreach (var d in salida.DetalleSalida) { <article class="detail-item-card"><div class="d-flex justify-content-between gap-3"><div><div class="fw-semibold">@d.Producto.Nombre</div><div class="small text-muted">@d.Producto.CategoriaProducto?.Nombre</div></div><div class="text-end"><span class="detail-quantity">@d.Cantidad</span><div class="small text-muted">unidades</div></div></div><dl><div><dt>Marca / modelo</dt><dd>@d.Marca?.Nombre @(d.Modelo != null ? $"· {d.Modelo.Nombre}" : "")</dd></div><div><dt>Origen</dt><dd>@if (d.DetalleEntrada?.Entrada != null) { <a href="@($"/entradas/{d.DetalleEntrada.Entrada.Id}")">Entrada #@d.DetalleEntrada.Entrada.Id</a> } else if (d.DetalleAjusteOrigen?.Ajuste != null) { <a href="@($"/ajustes/{d.DetalleAjusteOrigen.Ajuste.Id}")">Ajuste #@d.DetalleAjusteOrigen.Ajuste.Id</a> } else { <span>—</span> }</dd></div><div class="full"><dt>Series</dt><dd>@(seriesPorProducto.TryGetValue(d.id_producto, out var series) && series.Count > 0 ? string.Join(", ", series) : "Sin serie")</dd></div></dl></article> }</div></section>
}

@code {
    [Parameter] public int Id { get; set; }
    private Salida? salida; private string? usuario; private Dictionary<int, List<string>> seriesPorProducto = new();
    protected override async Task OnInitializedAsync() { salida = await SalidaService.GetByIdAsync(Id); if (salida == null) { Nav.NavigateTo("/salidas"); return; } usuario = await UserDisplayNameService.GetNombreAsync(salida.IdUsuario); var series = await ProductoSerieService.GetSeriesPorSalidaAsync(Id); seriesPorProducto = series.GroupBy(x => x.id_producto).ToDictionary(g => g.Key, g => g.Select(x => x.Serie).OrderBy(x => x).ToList()); }
    private void Volver() => Nav.NavigateTo("/salidas"); private void Editar() => Nav.NavigateTo($"/salidas/editar/{Id}");
}
