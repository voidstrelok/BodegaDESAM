@page "/ajustes"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.Public)]
@using BodegaDESAM.Services
@inject AjusteInventarioService AjusteService
@inject NavigationManager Nav
@inject BodegaContextService BodegaContext
@inject AuthenticationStateProvider AuthState

<div class="page-header"><div><h3 class="page-title m-0">Ajustes de inventario</h3><p class="page-subtitle mb-0">Regularizaciones y correcciones de stock.</p></div><AuthorizeView Roles="@BodegaDESAM.Auth.AppRoles.AdminOrBodega"><Authorized><button type="button" class="btn btn-primary" @onclick="Nuevo"><i class="bi bi-plus-lg me-1"></i>Nuevo ajuste</button></Authorized></AuthorizeView></div>
<div class="page-toolbar mb-3"><SearchBox Value="@request.Search" ValueChanged="BuscarAsync" Placeholder="Buscar por bodega, motivo u observación..." AriaLabel="Buscar ajustes" /></div>
@if (resultado is null) { <p>Cargando...</p> }
else if (resultado.TotalItems == 0) { <div class="empty-state">No hay ajustes que coincidan con la búsqueda.</div> }
else
{
    <div class="movement-table card-section d-none d-md-block"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Código</th><th>Fecha</th><th>Bodega</th><th>Motivo</th><th>Ítems</th><th class="text-end">Total aumentos (CLP)</th><th>Acciones</th></tr></thead><tbody>@foreach (var a in resultado.Items) { <tr><td class="fw-semibold">#@a.Id</td><td class="text-nowrap">@a.Fecha.ToString("dd/MM/yyyy")</td><td>@a.Bodega?.Nombre</td><td><div class="text-truncate" title="@a.Motivo">@a.Motivo</div></td><td class="text-center">@a.DetalleAjuste.Count</td><td class="text-end text-nowrap">@FormatoTotal(a)</td><td><div class="movement-actions"><button class="btn btn-outline-secondary btn-sm" @onclick="() => Ver(a.Id)" title="Ver detalle"><i class="bi bi-eye"></i></button><AuthorizeView Roles="@BodegaDESAM.Auth.AppRoles.AdminOrBodega"><Authorized><button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmarEliminar(a.Id)" title="Eliminar"><i class="bi bi-trash"></i></button></Authorized></AuthorizeView></div></td></tr> }</tbody></table></div></div>
    <div class="movement-cards d-md-none">@foreach (var a in resultado.Items) { <article class="movement-card card-section"><div class="movement-card-header"><div><span class="movement-kind">Ajuste</span><div class="fw-semibold">#@a.Id</div></div><time class="text-muted small">@a.Fecha.ToString("dd/MM/yyyy")</time></div><dl class="movement-card-data"><div><dt>Bodega</dt><dd>@a.Bodega?.Nombre</dd></div><div><dt>Ítems</dt><dd>@a.DetalleAjuste.Count</dd></div><div><dt>Total aumentos</dt><dd>@FormatoTotal(a)</dd></div></dl><p class="movement-note">@a.Motivo</p><div class="movement-card-actions"><button class="btn btn-outline-secondary" @onclick="() => Ver(a.Id)">Ver detalle</button><AuthorizeView Roles="@BodegaDESAM.Auth.AppRoles.AdminOrBodega"><Authorized><button class="btn btn-outline-danger" @onclick="() => ConfirmarEliminar(a.Id)"><i class="bi bi-trash"></i></button></Authorized></AuthorizeView></div></article> }</div>
    <PaginationControls Page="@resultado.Page" TotalPages="@resultado.TotalPages" TotalItems="@resultado.TotalItems" PageSize="@resultado.PageSize" PageChanged="CambiarPaginaAsync" PageSizeChanged="CambiarTamanoAsync" />
}
@if (mostrarConfirmacion && idAEliminar.HasValue) { <div class="modal fade show d-block" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Eliminar ajuste</h5><button class="btn-close" @onclick="CancelarEliminar"></button></div><div class="modal-body">¿Está seguro que desea eliminar el ajuste <strong>#@idAEliminar</strong>?</div><div class="modal-footer"><button class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button><button class="btn btn-danger" @onclick="EjecutarEliminar">Eliminar</button></div></div></div></div><div class="modal-backdrop fade show"></div> }
@if (!string.IsNullOrWhiteSpace(errorMsg)) { <div class="alert alert-danger mt-3">@errorMsg</div> }

@code {
    private PagedResult<AjusteInventario>? resultado; private readonly PageRequest request = new(); private bool mostrarConfirmacion; private int? idAEliminar; private string? errorMsg;
    protected override async Task OnInitializedAsync() => await CargarAsync();
    private async Task CargarAsync() { using var loading = LoadingState.Begin(); resultado = await AjusteService.GetPageAsync(await BodegaContext.GetBodegaActivaAsync(), request); }
    private async Task BuscarAsync(string? texto) { request.Search = texto; request.Page = 1; await CargarAsync(); }
    private async Task CambiarPaginaAsync(int pagina) { request.Page = pagina; await CargarAsync(); }
    private async Task CambiarTamanoAsync(int tamano) { request.PageSize = tamano; request.Page = 1; await CargarAsync(); }
    private void Nuevo() => Nav.NavigateTo("/ajustes/nuevo"); private void Ver(int id) => Nav.NavigateTo($"/ajustes/{id}");
    private void ConfirmarEliminar(int id) { idAEliminar = id; mostrarConfirmacion = true; errorMsg = null; }
    private void CancelarEliminar() { mostrarConfirmacion = false; idAEliminar = null; }
    private async Task EjecutarEliminar() { using var loading = LoadingState.Begin(); if (!idAEliminar.HasValue) return; try { var authState = await AuthState.GetAuthenticationStateAsync(); var usuarioId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; if (string.IsNullOrWhiteSpace(usuarioId)) { errorMsg = "No se pudo identificar al usuario actual para registrar la auditoría."; return; } await AjusteService.DeleteAsync(idAEliminar.Value, usuarioId); mostrarConfirmacion = false; idAEliminar = null; await CargarAsync(); } catch (Exception ex) { errorMsg = ex.Message; mostrarConfirmacion = false; } }
    private static string FormatoTotal(AjusteInventario ajuste) { var aumentos = ajuste.DetalleAjuste.Where(d => d.TipoAjuste == TipoAjuste.Aumento).ToList(); if (aumentos.Count == 0) return "$ 0"; if (aumentos.Any(d => !d.ValorUnitario.HasValue)) return "Sin valorizar"; return $"$ {aumentos.Sum(d => (decimal)d.Cantidad * d.ValorUnitario!.Value):N0}"; }
}
