@page "/ajustes"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.Public)]

@using BodegaDESAM.Services
@inject AjusteInventarioService AjusteService
@inject NavigationManager Nav

<div class="page-header"><div><h3 class="page-title m-0">Ajustes de inventario</h3><p class="page-subtitle mb-0">Regularizaciones y correcciones de stock.</p></div><AuthorizeView Roles="@BodegaDESAM.Auth.AppRoles.AdminOrBodega"><Authorized><button type="button" class="btn btn-primary" @onclick="Nuevo"><i class="bi bi-plus-lg me-1"></i>Nuevo ajuste</button></Authorized></AuthorizeView></div>

@if (ajustes == null) { <p>Cargando...</p> }
else if (ajustes.Count == 0) { <div class="empty-state">No hay ajustes registrados.</div> }
else
{
    <div class="movement-table card-section d-none d-md-block"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th class="movement-code">Código</th><th class="movement-date">Fecha</th><th>Bodega</th><th>Motivo</th><th class="items-column">Ítems</th><th class="movement-actions-col">Acciones</th></tr></thead><tbody>@foreach (var a in ajustes) { <tr><td class="fw-semibold">#@a.Id</td><td class="text-nowrap">@a.Fecha.ToString("dd/MM/yyyy")</td><td><div class="text-truncate" title="@a.Bodega?.Nombre">@a.Bodega?.Nombre</div></td><td><div class="text-truncate" title="@a.Motivo">@a.Motivo</div></td><td class="text-center">@a.DetalleAjuste.Count</td><td><div class="movement-actions"><button class="btn btn-outline-secondary btn-sm" title="Ver detalle" aria-label="Ver detalle de ajuste @a.Id" @onclick="() => Ver(a.Id)"><i class="bi bi-eye"></i></button><AuthorizeView Roles="@BodegaDESAM.Auth.AppRoles.AdminOrBodega"><Authorized><button class="btn btn-outline-danger btn-sm" title="Eliminar" aria-label="Eliminar ajuste @a.Id" @onclick="() => ConfirmarEliminar(a.Id)"><i class="bi bi-trash"></i></button></Authorized></AuthorizeView></div></td></tr> }</tbody></table></div></div>
    <div class="movement-cards d-md-none">@foreach (var a in ajustes) { <article class="movement-card card-section"><div class="movement-card-header"><div><span class="movement-kind">Ajuste</span><div class="fw-semibold">#@a.Id</div></div><time class="text-muted small">@a.Fecha.ToString("dd/MM/yyyy")</time></div><dl class="movement-card-data"><div><dt>Bodega</dt><dd>@a.Bodega?.Nombre</dd></div><div><dt>Ítems</dt><dd>@a.DetalleAjuste.Count</dd></div></dl><p class="movement-note">@a.Motivo</p><div class="movement-card-actions"><button class="btn btn-outline-secondary" @onclick="() => Ver(a.Id)">Ver detalle</button><AuthorizeView Roles="@BodegaDESAM.Auth.AppRoles.AdminOrBodega"><Authorized><button class="btn btn-outline-danger" @onclick="() => ConfirmarEliminar(a.Id)" aria-label="Eliminar"><i class="bi bi-trash"></i></button></Authorized></AuthorizeView></div></article> }</div>
}

@if (mostrarConfirmacion && idAEliminar.HasValue) { <div class="modal fade show d-block" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Confirmar eliminación</h5><button class="btn-close" @onclick="CancelarEliminar"></button></div><div class="modal-body">¿Está seguro que desea eliminar el ajuste <strong>#@idAEliminar</strong>? Esta acción no se puede deshacer.</div><div class="modal-footer"><button class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button><button class="btn btn-danger" @onclick="EjecutarEliminar">Eliminar</button></div></div></div></div><div class="modal-backdrop fade show"></div> }
@if (!string.IsNullOrWhiteSpace(errorMsg)) { <div class="alert alert-danger mt-3">@errorMsg</div> }

@code {
    private List<AjusteInventario>? ajustes; private bool mostrarConfirmacion; private int? idAEliminar; private string? errorMsg;
    protected override async Task OnInitializedAsync() => await CargarAsync(); private async Task CargarAsync() => ajustes = await AjusteService.GetAllAsync();
    private void Nuevo() => Nav.NavigateTo("/ajustes/nuevo"); private void Ver(int id) => Nav.NavigateTo($"/ajustes/{id}");
    private void ConfirmarEliminar(int id) { idAEliminar = id; mostrarConfirmacion = true; errorMsg = null; }
    private void CancelarEliminar() { mostrarConfirmacion = false; idAEliminar = null; }
    private async Task EjecutarEliminar() { if (!idAEliminar.HasValue) return; try { await AjusteService.DeleteAsync(idAEliminar.Value, "sistema"); mostrarConfirmacion = false; idAEliminar = null; await CargarAsync(); } catch (Exception ex) { errorMsg = ex.Message; mostrarConfirmacion = false; } }
}
