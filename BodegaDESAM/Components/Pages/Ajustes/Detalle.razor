@page "/ajustes/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.Public)]

@using BodegaDESAM.Services
@inject AjusteInventarioService AjusteService
@inject ProductoSerieService SerieService
@inject UserDisplayNameService UserDisplayNameService
@inject NavigationManager Nav
@inject BodegaContextService BodegaContext

@if (ajuste == null) { <p>Cargando...</p> }
else
{
    <div class="detail-header"><div class="d-flex align-items-center gap-2"><button class="btn btn-outline-secondary btn-sm" @onclick="Volver"><i class="bi bi-arrow-left"></i><span class="visually-hidden">Volver</span></button><div><span class="movement-kind">Ajuste</span><h3 class="page-title m-0">Detalle #@ajuste.Id</h3></div></div></div>
    <section class="card-section detail-summary"><h5>Información general</h5><dl class="detail-grid"><div><dt>Fecha</dt><dd>@ajuste.Fecha.ToString("dd/MM/yyyy")</dd></div><div><dt>Bodega</dt><dd>@ajuste.Bodega?.Nombre</dd></div><div><dt>Motivo</dt><dd>@ajuste.Motivo</dd></div><div><dt>Registrado por</dt><dd>@(usuario ?? "Usuario no disponible")</dd></div></dl>@if (!string.IsNullOrWhiteSpace(ajuste.Observacion)) { <div class="detail-observation"><span>Observación</span><p>@ajuste.Observacion</p></div> }</section>
    <section class="card-section detail-items"><div class="detail-section-heading"><div><h5 class="mb-0">Productos ajustados</h5><span class="text-muted small">@ajuste.DetalleAjuste.Count ítem(s)</span></div></div><div class="table-responsive d-none d-md-block"><table class="table table-hover align-middle mb-0"><thead><tr><th>Producto</th><th>Tipo</th><th>Detalle</th><th>Origen</th><th class="text-end">Cantidad</th><th class="text-end">Valor unitario (CLP)</th></tr></thead><tbody>@foreach (var d in ajuste.DetalleAjuste) { <tr><td><div class="fw-semibold">@d.Producto?.Nombre</div><div class="small text-muted">@d.Marca?.Nombre @if (d.Modelo != null) { <span>· @d.Modelo.Nombre</span> }</div></td><td>@if (d.TipoAjuste == TipoAjuste.Aumento) { <span class="badge bg-success">Aumento</span> } else { <span class="badge bg-warning text-dark">Disminución</span> }</td><td><div>@if (d.Lote != null) { <span>Lote: @d.Lote.Codigo</span> } @if (d.FechaVencimiento.HasValue) { <span class="text-muted"> · Vence @d.FechaVencimiento.Value.ToString("dd/MM/yyyy")</span> }</div>@if (seriesPorDetalle.TryGetValue(d.Id, out var series) && series.Count > 0) { <div class="series-cell">@string.Join(", ", series)</div> }</td><td>@if (d.TipoAjuste == TipoAjuste.Disminucion && d.DetalleEntradaOrigen?.Entrada != null) { <a href="@($"/entradas/{d.DetalleEntradaOrigen.Entrada.Id}")">Entrada #@d.DetalleEntradaOrigen.Entrada.Id</a> } else if (d.TipoAjuste == TipoAjuste.Disminucion && d.DetalleAjusteOrigen?.Ajuste != null) { <a href="@($"/ajustes/{d.DetalleAjusteOrigen.Ajuste.Id}")">Ajuste #@d.DetalleAjusteOrigen.Ajuste.Id</a> } else { <span class="text-muted">Sin origen</span> }</td><td class="text-end fw-semibold">@d.Cantidad</td><td class="text-end text-nowrap">@FormatoValor(d)</td></tr> }</tbody></table></div><div class="detail-item-cards d-md-none">@foreach (var d in ajuste.DetalleAjuste) { <article class="detail-item-card"><div class="d-flex justify-content-between gap-3"><div><div class="fw-semibold">@d.Producto?.Nombre</div><div class="small text-muted">@d.Marca?.Nombre @if (d.Modelo != null) { <span>· @d.Modelo.Nombre</span> }</div></div><div class="text-end"><span class="detail-quantity">@d.Cantidad</span><div class="small text-muted">unidades</div></div></div><dl><div><dt>Tipo</dt><dd>@(d.TipoAjuste == TipoAjuste.Aumento ? "Aumento" : "Disminución")</dd></div><div><dt>Lote / vencimiento</dt><dd>@(d.Lote?.Codigo ?? "—") @(d.FechaVencimiento.HasValue ? $"· {d.FechaVencimiento.Value:dd/MM/yyyy}" : "")</dd></div><div><dt>Valor unitario</dt><dd>@FormatoValor(d)</dd></div><div class="full"><dt>Series</dt><dd>@(seriesPorDetalle.TryGetValue(d.Id, out var series) && series.Count > 0 ? string.Join(", ", series) : "Sin serie")</dd></div></dl></article> }</div></section>
}

@code {
    [Parameter] public int Id { get; set; }
    private AjusteInventario? ajuste; private string? usuario; private Dictionary<int, List<string>> seriesPorDetalle = new();
    protected override async Task OnInitializedAsync() { using var loading = LoadingState.Begin(); ajuste = await AjusteService.GetByIdAsync(Id, await BodegaContext.GetBodegaActivaAsync()); if (ajuste == null) { Nav.NavigateTo("/ajustes"); return; } usuario = await UserDisplayNameService.GetNombreCompletoAsync(ajuste.IdUsuario); var series = await SerieService.GetSeriesPorAjusteAsync(Id); seriesPorDetalle = series.GroupBy(x => x.id_detalle_ajuste ?? 0).ToDictionary(g => g.Key, g => g.Select(x => x.Serie).ToList()); }
    private void Volver() => Nav.NavigateTo("/ajustes");
    private static string FormatoValor(DetalleAjuste detalle) => detalle.TipoAjuste == TipoAjuste.Disminucion ? "Desde origen" : detalle.ValorUnitario.HasValue ? $"$ {detalle.ValorUnitario.Value:N0}" : "Sin valor";
}
