@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout BodegaDESAM.Components.Layout.AuthLayout

@inject NavigationManager Nav

<PageTitle>Login</PageTitle>

<div class="login-card">
    <div class="login-mobile-brand"><i class="bi bi-box-seam-fill"></i><span>Bodega DESAM</span></div>
    <div class="login-heading">
        <h2>Bienvenido/a</h2>
        <p>Ingresa tus credenciales para continuar.</p>
    </div>
    <form method="post" action="/auth/login" data-enhance="false">
        <AntiforgeryToken />

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <div class="mb-3">
            <label class="form-label" for="login-user">Nombre de Usuario</label>
            <div class="input-group login-input-group"><span class="input-group-text"><i class="bi bi-person"></i></span><input id="login-user" name="user" type="text" class="form-control" placeholder="nombre@sector" autocomplete="username" required /></div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="login-password">Contraseña</label>
            <div class="input-group login-input-group"><span class="input-group-text"><i class="bi bi-lock"></i></span><input id="login-password" name="password" type="password" class="form-control" autocomplete="current-password" required /></div>
        </div>

        <div class="form-check login-remember">
            <input id="login-remember" name="rememberMe" type="checkbox" class="form-check-input" value="true" />
            <label class="form-check-label" for="login-remember">Recordarme</label>
        </div>

        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <button class="btn btn-primary login-submit w-100" type="submit"><i class="bi bi-box-arrow-in-right me-2"></i>Ingresar</button>
    </form>
</div>

@code {
    string? error;
    string? returnUrl;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("error", out var value) && value == "1")
            error = "Credenciales inválidas.";

        if (query.TryGetValue("returnUrl", out var requestedReturnUrl) && !string.IsNullOrWhiteSpace(requestedReturnUrl))
            returnUrl = requestedReturnUrl.ToString();
    }
}
