@page "/logout"
@layout BodegaDESAM.Components.Layout.AuthLayout

<PageTitle>Cerrar sesión</PageTitle>

<div class="login-card text-center">
    <p class="text-muted">¿Deseas cerrar la sesión actual?</p>
    <form method="post" action="/auth/logout" data-enhance="false">
        <AntiforgeryToken />
        <button class="btn btn-outline-danger" type="submit">Cerrar sesión</button>
    </form>
</div>
