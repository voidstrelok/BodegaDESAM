@page "/productos"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.AdminOrBodega)]
@using BodegaDESAM.Services
@inject ProductoService Service
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3"><h3 class="page-title m-0">Productos</h3><button type="button" class="btn btn-primary btn-sm" @onclick="Nuevo">Nuevo</button></div>
<div class="page-toolbar mb-3"><SearchBox Value="@request.Search" ValueChanged="BuscarAsync" Placeholder="Buscar por código o nombre..." AriaLabel="Buscar productos" /></div>
@if (resultado is null) { <p>Cargando...</p> }
else if (resultado.TotalItems == 0) { <p>No hay productos que coincidan con la búsqueda.</p> }
else { <div class="card-section p-2"><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Código</th><th>Nombre</th><th>Acciones</th></tr></thead><tbody>@foreach (var p in resultado.Items) { <tr><td>@p.Id</td><td>@p.Nombre</td><td class="text-nowrap"><button class="btn btn-outline-primary btn-sm" @onclick='() => Nav.NavigateTo($"/productos/editar/{p.Id}")'>Editar</button><button class="btn btn-danger btn-sm ms-1" @onclick="() => Eliminar(p.Id)">Eliminar</button></td></tr> }</tbody></table></div><PaginationControls Page="@resultado.Page" TotalPages="@resultado.TotalPages" TotalItems="@resultado.TotalItems" PageSize="@resultado.PageSize" PageChanged="CambiarPaginaAsync" PageSizeChanged="CambiarTamanoAsync" /></div> }

@code {
    private PagedResult<Producto>? resultado; private readonly PageRequest request = new();
    protected override async Task OnInitializedAsync() => await CargarAsync();
    private async Task CargarAsync() { using var loading = LoadingState.Begin(); resultado = await Service.GetPageAsync(request); }
    private async Task BuscarAsync(string? texto) { request.Search = texto; request.Page = 1; await CargarAsync(); }
    private async Task CambiarPaginaAsync(int pagina) { request.Page = pagina; await CargarAsync(); }
    private async Task CambiarTamanoAsync(int tamano) { request.PageSize = tamano; request.Page = 1; await CargarAsync(); }
    private void Nuevo() => Nav.NavigateTo("/productos/nuevo"); private async Task Eliminar(int id) => await Task.CompletedTask;
}
