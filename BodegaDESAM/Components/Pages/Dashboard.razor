@page "/dashboard"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.Public)]
@using BodegaDESAM.Services
@inject DashboardService DashboardService
@inject AlertaService AlertaService
@inject BodegaContextService BodegaContext

<div class="page-header dashboard-header">
    <div><h3 class="page-title m-0">Panel de control</h3><p class="page-subtitle mb-0">Inventario, valorización y despachos del mes en curso.</p></div>
    <div class="dashboard-action-links"><a class="btn btn-outline-secondary" href="inventario"><i class="bi bi-boxes me-1"></i>Ver inventario</a><AuthorizeView Roles="@BodegaDESAM.Auth.AppRoles.AdminOrBodega"><Authorized><a class="btn btn-primary" href="salidas/nuevo"><i class="bi bi-box-arrow-up-right me-1"></i>Registrar salida</a></Authorized></AuthorizeView></div>
</div>

@if (cargando)
{
    <div class="d-flex justify-content-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>
}
else if (resumen is not null)
{
    <section class="dashboard-kpis" aria-label="Indicadores principales">
        <article class="card-section dashboard-kpi"><div class="dashboard-kpi-icon primary"><i class="bi bi-cash-stack"></i></div><div><span>Inventario valorizado</span><strong>@Dinero(resumen.ValorInventario)</strong><small>@resumen.TotalUnidadesEnStock.ToString("N0") unidades disponibles</small></div></article>
        <article class="card-section dashboard-kpi"><div class="dashboard-kpi-icon success"><i class="bi bi-box-arrow-in-down-left"></i></div><div><span>Entradas del mes</span><strong>@Dinero(resumen.ValorEntradasEsteMes)</strong><small>@resumen.EntradasEsteMes recepciones registradas</small></div></article>
        <article class="card-section dashboard-kpi"><div class="dashboard-kpi-icon warning"><i class="bi bi-box-arrow-up-right"></i></div><div><span>Salidas del mes</span><strong>@Dinero(resumen.ValorSalidasEsteMes)</strong><small>@resumen.SalidasEsteMes despachos registrados</small></div></article>
        <article class="card-section dashboard-kpi"><div class="dashboard-kpi-icon info"><i class="bi bi-boxes"></i></div><div><span>Productos con stock</span><strong>@resumen.TotalProductosDistintos</strong><small>referencias disponibles</small></div></article>
    </section>

    <div class="row g-3">
        <div class="col-12 col-xl-5"><section class="card-section dashboard-panel dashboard-alerts h-100"><div class="dashboard-panel-header"><div><span class="movement-kind text-danger">Prioridad operativa</span><h5 class="mb-0"><i class="bi bi-bell-fill text-danger me-1"></i>Alertas activas</h5></div>@if (alertas.Count > 0) { <span class="badge bg-danger rounded-pill">@alertas.Count</span> }</div>@if (alertas.Count == 0) { <div class="dashboard-empty"><i class="bi bi-check-circle-fill text-success"></i><span>Sin alertas activas</span></div> } else { <ul class="list-group list-group-flush">@foreach (var alerta in alertas) { <li class="list-group-item"><div class="d-flex align-items-start gap-2"><i class="bi @(alerta.Severidad == SeveridadAlerta.Critica ? "bi-exclamation-triangle-fill text-danger" : "bi-exclamation-circle-fill text-warning") mt-1"></i>@if (RutaMovimiento(alerta) is string ruta) { <a class="small text-primary" href="@ruta" title="Ver movimiento asociado">@alerta.Mensaje</a> } else { <span class="small">@alerta.Mensaje</span> }</div></li> }</ul> }</section></div>
        <div class="col-12 col-xl-7"><section class="card-section dashboard-panel h-100"><div class="dashboard-panel-header"><div><span class="movement-kind">Despachos del mes</span><h5 class="mb-0"><i class="bi bi-building-check me-1"></i>Salidas por establecimiento</h5></div><a class="btn btn-sm btn-outline-secondary" href="salidas">Ver salidas</a></div>@if (resumen.SalidasPorEstablecimiento.Count == 0) { <div class="dashboard-empty"><i class="bi bi-send text-muted"></i><span>Sin salidas registradas este mes</span></div> } else { <div class="table-responsive"><table class="table table-hover align-middle mb-0 dashboard-movements"><thead><tr><th>Establecimiento</th><th class="text-end">Documentos</th><th class="text-end">Unidades</th><th class="text-end">Valorización</th></tr></thead><tbody>@foreach (var salida in resumen.SalidasPorEstablecimiento) { <tr><td class="fw-semibold">@salida.Nombre</td><td class="text-end text-muted">@salida.Documentos</td><td class="text-end">@salida.Unidades.ToString("N0")</td><td class="text-end fw-semibold">@Dinero(salida.Valor)</td></tr> }</tbody></table></div> }</section></div>
    </div>

    <div class="row g-3 mt-0">
        <div class="col-12 col-lg-6"><section class="card-section dashboard-panel h-100"><div class="dashboard-panel-header"><div><span class="movement-kind text-success">Abastecimiento</span><h5 class="mb-0"><i class="bi bi-graph-up-arrow text-success me-1"></i>Productos con más entradas</h5></div><span class="text-muted small">Este mes</span></div>@if (resumen.ProductosMasEntraron.Count == 0) { <div class="dashboard-empty"><i class="bi bi-inbox text-muted"></i><span>Sin entradas registradas este mes</span></div> } else { <div class="dashboard-ranking">@foreach (var item in resumen.ProductosMasEntraron) { <div class="dashboard-ranking-row"><div><span class="dashboard-ranking-name">@item.Nombre</span><small>@item.Unidades.ToString("N0") unidades</small></div><strong class="text-success">@Dinero(item.Valor)</strong></div> }</div> }</section></div>
        <div class="col-12 col-lg-6"><section class="card-section dashboard-panel h-100"><div class="dashboard-panel-header"><div><span class="movement-kind text-danger">Consumo</span><h5 class="mb-0"><i class="bi bi-graph-down-arrow text-danger me-1"></i>Productos con más salidas</h5></div><span class="text-muted small">Este mes</span></div>@if (resumen.ProductosMasSalieron.Count == 0) { <div class="dashboard-empty"><i class="bi bi-inbox text-muted"></i><span>Sin salidas registradas este mes</span></div> } else { <div class="dashboard-ranking">@foreach (var item in resumen.ProductosMasSalieron) { <div class="dashboard-ranking-row"><div><span class="dashboard-ranking-name">@item.Nombre</span><small>@item.Unidades.ToString("N0") unidades</small></div><strong class="text-danger">@Dinero(item.Valor)</strong></div> }</div> }</section></div>
    </div>
}

@code {
    private DashboardResumenDto? resumen;
    private List<AlertaDto> alertas = new();
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        using var loading = LoadingState.Begin();
        try
        {
            var id = await BodegaContext.GetBodegaActivaAsync();
            if (id.HasValue)
            {
                var resumenTask = DashboardService.GetResumenAsync(id.Value);
                var alertasTask = AlertaService.GetAlertasActivasAsync(id);
                await Task.WhenAll(resumenTask, alertasTask);
                resumen = resumenTask.Result;
                alertas = alertasTask.Result;
            }
        }
        finally { cargando = false; }
    }

    private static string? RutaMovimiento(AlertaDto alerta) => alerta.TipoMovimiento switch
    {
        "Entrada" when alerta.IdMovimiento.HasValue => $"/entradas/{alerta.IdMovimiento.Value}",
        "Ajuste" when alerta.IdMovimiento.HasValue => $"/ajustes/{alerta.IdMovimiento.Value}",
        _ => null
    };

    private static string Dinero(decimal valor) => $"$ {valor:N0}";
}
