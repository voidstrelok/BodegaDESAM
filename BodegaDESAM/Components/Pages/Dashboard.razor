@page "/dashboard"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.Public)]

@using BodegaDESAM.Services
@inject DashboardService DashboardService
@inject AlertaService AlertaService
@inject NavigationManager Nav

<div class="page-header dashboard-header"><div><h3 class="page-title m-0">Resumen de bodega</h3><p class="page-subtitle mb-0">Estado del inventario y actividad del mes.</p></div><a class="btn btn-outline-secondary" href="inventario"><i class="bi bi-boxes me-1"></i>Ver inventario</a></div>

@if (cargando) { <div class="d-flex justify-content-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div> }
else if (resumen is not null)
{
    <section class="dashboard-kpis" aria-label="Indicadores principales">
        <article class="card-section dashboard-kpi"><div class="dashboard-kpi-icon primary"><i class="bi bi-boxes"></i></div><div><span>Productos con stock</span><strong>@resumen.TotalProductosDistintos</strong><small>productos distintos</small></div></article>
        <article class="card-section dashboard-kpi"><div class="dashboard-kpi-icon success"><i class="bi bi-stack"></i></div><div><span>Unidades disponibles</span><strong>@resumen.TotalUnidadesEnStock.ToString("N0")</strong><small>unidades totales</small></div></article>
        <article class="card-section dashboard-kpi"><div class="dashboard-kpi-icon info"><i class="bi bi-box-arrow-in-down-left"></i></div><div><span>Entradas este mes</span><strong>@resumen.EntradasEsteMes</strong><small>recepciones registradas</small></div></article>
        <article class="card-section dashboard-kpi"><div class="dashboard-kpi-icon warning"><i class="bi bi-box-arrow-up-right"></i></div><div><span>Salidas este mes</span><strong>@resumen.SalidasEsteMes</strong><small>despachos registrados</small></div></article>
    </section>

    <section class="card-section dashboard-actions"><div><span class="movement-kind">Accesos rápidos</span></div><div class="dashboard-action-links"><a class="btn btn-outline-secondary" href="inventario"><i class="bi bi-search me-1"></i>Consultar stock</a><AuthorizeView Roles="@BodegaDESAM.Auth.AppRoles.AdminOrBodega"><Authorized><a class="btn btn-primary" href="entradas/nuevo"><i class="bi bi-plus-lg me-1"></i>Nueva entrada</a><a class="btn btn-outline-primary" href="salidas/nuevo"><i class="bi bi-box-arrow-up-right me-1"></i>Nueva salida</a><a class="btn btn-outline-secondary" href="ajustes/nuevo"><i class="bi bi-sliders me-1"></i>Ajustar stock</a></Authorized></AuthorizeView></div></section>

    <div class="row g-3">
        <div class="col-12 col-xl-4"><section class="card-section dashboard-panel h-100"><div class="dashboard-panel-header"><div><span class="movement-kind">Atención</span><h5 class="mb-0"><i class="bi bi-bell-fill text-danger me-1"></i>Alertas activas</h5></div>@if (alertas.Count > 0) { <span class="badge bg-danger">@alertas.Count</span> }</div>@if (alertas.Count == 0) { <div class="dashboard-empty"><i class="bi bi-check-circle-fill text-success"></i><span>Sin alertas activas</span></div> } else { <ul class="list-group list-group-flush">@foreach (var alerta in alertas) { <li class="list-group-item"><div class="d-flex align-items-start gap-2"><i class="bi @(alerta.Severidad == SeveridadAlerta.Critica ? "bi-exclamation-triangle-fill text-danger" : "bi-exclamation-circle-fill text-warning") mt-1"></i>@if (RutaMovimiento(alerta) is string ruta) { <a class="small text-primary" href="@ruta" title="Ver movimiento asociado">@alerta.Mensaje</a> } else { <span class="small">@alerta.Mensaje</span> }</div></li> }</ul> }</section></div>
        <div class="col-12 col-xl-8"><section class="card-section dashboard-panel h-100"><div class="dashboard-panel-header"><div><span class="movement-kind">Actividad reciente</span><h5 class="mb-0"><i class="bi bi-arrow-left-right me-1"></i>Últimos movimientos</h5></div><span class="text-muted small">Incluye @resumen.AjustesEsteMes ajuste(s) este mes</span></div>@if (resumen.UltimosMovimientos.Count == 0) { <div class="dashboard-empty"><i class="bi bi-inbox text-muted"></i><span>Sin movimientos registrados</span></div> } else { <div class="table-responsive"><table class="table table-hover align-middle mb-0 dashboard-movements"><thead><tr><th>Tipo</th><th>Documento</th><th>Fecha</th><th>Referencia / contraparte</th><th></th></tr></thead><tbody>@foreach (var mov in resumen.UltimosMovimientos) { <tr><td><span class="badge @TipoClase(mov.Tipo)"><i class="bi @TipoIcono(mov.Tipo) me-1"></i>@mov.Tipo</span></td><td class="fw-semibold">#@mov.IdDocumento</td><td class="text-muted small text-nowrap">@mov.Fecha.ToString("dd/MM/yyyy")</td><td class="small">@mov.Referencia @if (!string.IsNullOrWhiteSpace(mov.Contraparte)) { <span class="text-muted">— @mov.Contraparte</span> }</td><td><button class="btn btn-outline-secondary btn-sm" @onclick="() => VerMovimiento(mov)">Ver</button></td></tr> }</tbody></table></div> }</section></div>
    </div>
}

@code {
    private DashboardResumenDto? resumen; private List<AlertaDto> alertas = new(); private bool cargando = true;
    protected override async Task OnInitializedAsync() { using var loading = LoadingState.Begin(); try { var resumenTask = DashboardService.GetResumenAsync(); var alertasTask = AlertaService.GetAlertasActivasAsync(); await Task.WhenAll(resumenTask, alertasTask); resumen = resumenTask.Result; alertas = alertasTask.Result; } finally { cargando = false; } }
    private static string TipoClase(string tipo) => tipo switch { "Entrada" => "bg-success", "Salida" => "bg-danger", _ => "bg-primary" };
    private static string TipoIcono(string tipo) => tipo switch { "Entrada" => "bi-box-arrow-in-down-left", "Salida" => "bi-box-arrow-up-right", _ => "bi-sliders" };
    private void VerMovimiento(UltimoMovimientoDto movimiento) => Nav.NavigateTo(movimiento.Tipo == "Entrada" ? $"/entradas/{movimiento.IdDocumento}" : movimiento.Tipo == "Salida" ? $"/salidas/{movimiento.IdDocumento}" : $"/ajustes/{movimiento.IdDocumento}");
    private static string? RutaMovimiento(AlertaDto alerta) => alerta.TipoMovimiento switch
    {
        "Entrada" when alerta.IdMovimiento.HasValue => $"/entradas/{alerta.IdMovimiento.Value}",
        "Ajuste" when alerta.IdMovimiento.HasValue => $"/ajustes/{alerta.IdMovimiento.Value}",
        _ => null
    };
}
