@page "/admin/bodegas/nueva"
@page "/admin/bodegas/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.Admin)]
@using BodegaDESAM.Services
@inject BodegaService Service
@inject NavigationManager Nav

<h3 class="page-title mb-3">@(Id.HasValue ? "Editar bodega" : "Nueva bodega")</h3>
<EditForm Model="bodega" OnValidSubmit="GuardarAsync" class="card-section p-3"><DataAnnotationsValidator /><ValidationSummary /><div class="row g-3"><div class="col-md-4"><label class="form-label">Código</label><InputText class="form-control" @bind-Value="bodega.Codigo" /></div><div class="col-md-8"><label class="form-label">Nombre</label><InputText class="form-control" @bind-Value="bodega.Nombre" /></div><div class="col-12"><label class="form-label">Dirección</label><InputText class="form-control" @bind-Value="bodega.Direccion" /></div><div class="col-12"><div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="bodega.EsPrincipal" /><label class="form-check-label">Bodega principal</label></div></div></div><div class="mt-3"><button class="btn btn-primary">Guardar</button><button type="button" class="btn btn-secondary ms-2" @onclick='() => Nav.NavigateTo("/admin/bodegas")'>Cancelar</button></div></EditForm>
@code { [Parameter] public int? Id { get; set; } Bodega bodega = new(); protected override async Task OnInitializedAsync() { if (Id.HasValue) bodega = await Service.GetByIdAsync(Id.Value) ?? new(); } async Task GuardarAsync() { if (Id.HasValue) await Service.UpdateAsync(bodega); else await Service.CreateAsync(bodega); Nav.NavigateTo("/admin/bodegas"); } }
