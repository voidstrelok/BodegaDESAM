@page "/admin/usuarios"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.Admin)]

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using BodegaDESAM.Models.Admin
@using BodegaDESAM.Services
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using System.Security.Cryptography

@inject UserManager<IdentityUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject BodegaService BodegaService
@inject UsuarioBodegaService UsuarioBodegaService
@inject IDbContextFactory<PostgresDataContext> DbFactory

<div class="users-page-header">
    <div><span class="movement-kind">Administración</span><h3 class="page-title mb-1">Usuarios y accesos</h3><p class="page-subtitle mb-0">Gestiona perfiles, roles y las bodegas a las que puede acceder cada persona.</p></div>
    @if (users is not null) { <span class="users-count"><i class="bi bi-people-fill"></i>@totalUsers usuario(s)</span> }
</div>

<AuthorizeView>
    <Authorized Context="auth">
        <div class="text-muted small mb-2">
            Sesión activa: @(auth.User.FindFirst("given_name")?.Value ?? auth.User.Identity?.Name)
        </div>
    </Authorized>
</AuthorizeView>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (!string.IsNullOrWhiteSpace(success))
{
    <div class="alert alert-success" role="alert">@success</div>
}

<div class="page-toolbar mb-3"><SearchBox Value="@request.Search" ValueChanged="BuscarAsync" Placeholder="Buscar por email, usuario o nombre..." AriaLabel="Buscar usuarios" /></div>

<div class="card-section users-create-card p-3 mb-4">
    <div class="users-section-heading"><div class="users-section-icon"><i class="bi bi-person-plus-fill"></i></div><div><h5>Nuevo usuario</h5><p>El acceso inicial se puede ajustar después por bodega.</p></div></div>
    <EditForm Model="create" OnValidSubmit="CreateUserAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-3">
            <div class="col-12 col-md-3">
                <label class="form-label">Nombre</label>
                <InputText class="form-control" @bind-Value="create.Nombre" />
                <ValidationMessage For="() => create.Nombre" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Apellido paterno</label>
                <InputText class="form-control" @bind-Value="create.Apellido" />
                <ValidationMessage For="() => create.Apellido" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Apellido materno</label>
                <InputText class="form-control" @bind-Value="create.ApellidoMaterno" />
                <ValidationMessage For="() => create.ApellidoMaterno" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="create.Email" placeholder="usuario@dominio.cl" />
                <ValidationMessage For="() => create.Email" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Password</label>
                <InputText class="form-control" type="password" @bind-Value="create.Password" placeholder="••••••••" />
                <ValidationMessage For="() => create.Password" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Rol inicial</label>
                <InputSelect class="form-select" @bind-Value="create.Role">
                    @foreach (var r in allRoles)
                    {
                        <option value="@r">@r</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => create.Role" />
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary" type="submit" disabled="@busy">Crear usuario</button>
        </div>
    </EditForm>
</div>

@if (users is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="card-section users-table-card p-2">
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0 users-table">
            <thead>
                <tr>
                    <th>Email/Usuario</th>
                    <th>Bodegas asignadas</th>
                    <th>Roles</th>
                    <th style="width: 420px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in users)
                {
                    <tr>
                        <td class="users-warehouses-cell">
                            @if (!u.IsEditing)
                            {
                                <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(u.Email) ? u.Email : u.UserName)</div>
                                @if (!string.IsNullOrWhiteSpace(u.Nombre) || !string.IsNullOrWhiteSpace(u.Apellido) || !string.IsNullOrWhiteSpace(u.ApellidoMaterno))
                                {
                                    <div class="text-muted small">@($"{u.Nombre} {u.Apellido} {u.ApellidoMaterno}".Trim())</div>
                                }
                                <div class="text-muted small">@u.Id</div>
                            }
                            else
                            {
                                <div class="row g-2">
                                    <div class="col-12">
                                        <InputText class="form-control form-control-sm" @bind-Value="u.Email" placeholder="Email" />
                                    </div>
                                    <div class="col-6">
                                        <InputText class="form-control form-control-sm" @bind-Value="u.Nombre" placeholder="Nombre" />
                                    </div>
                                    <div class="col-6">
                                        <InputText class="form-control form-control-sm" @bind-Value="u.Apellido" placeholder="Apellido paterno" />
                                    </div>
                                    <div class="col-6">
                                        <InputText class="form-control form-control-sm" @bind-Value="u.ApellidoMaterno" placeholder="Apellido materno" />
                                    </div>
                                    <div class="col-12">
                                        <div class="text-muted small">@u.Id</div>
                                    </div>
                                </div>
                            }
                        </td>
                        <td>
                            @if (u.Roles.Contains(BodegaDESAM.Auth.AppRoles.Admin))
                            {
                                <span class="badge text-bg-primary"><i class="bi bi-shield-check me-1"></i>Todas las bodegas</span>
                            }
                            else
                            {
                                @foreach (var bodega in bodegas)
                                {
                                    <div class="form-check form-check-inline users-warehouse-check">
                                        <input class="form-check-input" type="checkbox" checked="@EstaAsignada(u.Id, bodega.Id)" @onchange="e => CambiarBodegaAsync(u.Id, bodega.Id, e)" id="@($"ub-{u.Id}-{bodega.Id}")" />
                                        <label class="form-check-label small" for="@($"ub-{u.Id}-{bodega.Id}")">@bodega.Nombre</label>
                                    </div>
                                }
                            }
                        </td>
                        <td class="users-roles-cell">
                            @if (u.Roles.Count == 0)
                            {
                                <span class="text-muted">(sin roles)</span>
                            }
                            else
                            {
                                @foreach (var role in u.Roles) { <span class="badge text-bg-light border me-1">@role</span> }
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <select class="form-select form-select-sm" style="max-width: 200px;" value="@GetSelectedRole(u.Id)" @onchange="e => SetSelectedRole(u.Id, e.Value?.ToString())">
                                    @foreach (var r in allRoles)
                                    {
                                        <option value="@r">@r</option>
                                    }
                                </select>

                                @if (!u.IsEditing)
                                {
                                    <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => EditUser(u.Id)">Editar</button>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-sm" disabled="@busy" @onclick="() => SaveUserAsync(u.Id)">Guardar</button>
                                    <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => CancelEdit(u.Id)">Cancelar</button>
                                }

                                <button class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => AddRoleAsync(u.Id)" title="Agrega el rol seleccionado">Agregar rol</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => RemoveRoleAsync(u.Id)" title="Quita el rol seleccionado">Quitar rol</button>

                                <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => ResetPasswordAsync(u.Id)" title="Genera una clave temporal aleatoria">Reset password</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
        @if (userPage is not null) { <PaginationControls Page="@userPage.Page" TotalPages="@userPage.TotalPages" TotalItems="@userPage.TotalItems" PageSize="@userPage.PageSize" PageChanged="CambiarPaginaAsync" PageSizeChanged="CambiarTamanoAsync" /> }
    </div>
}

@code {
    List<UserWithRolesVm>? users;
    PagedResult<UserWithRolesVm>? userPage;
    readonly PageRequest request = new();
    int totalUsers;
    List<string> allRoles = new();
    Dictionary<string, string> roleSelection = new();
    Dictionary<string, UserWithRolesVm> original = new();
    List<Bodega> bodegas = new();
    Dictionary<string, HashSet<int>> bodegasPorUsuario = new();

    string? error;
    string? success;
    bool busy;

    readonly CreateUserVm create = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        using var loading = LoadingState.Begin();
        error = null;
        success = null;

        try
        {
        allRoles = RoleManager.Roles.Select(r => r.Name!).OrderBy(r => r).ToList();
        bodegas = await BodegaService.GetAllAsync();
        if (allRoles.Count == 0)
            allRoles = new() { BodegaDESAM.Auth.AppRoles.Admin, BodegaDESAM.Auth.AppRoles.Bodega, BodegaDESAM.Auth.AppRoles.Lectura };

        if (string.IsNullOrWhiteSpace(create.Role))
            create.Role = allRoles.FirstOrDefault() ?? BodegaDESAM.Auth.AppRoles.Lectura;

        using var db = DbFactory.CreateDbContext();
        var userQuery = db.Users.AsNoTracking().AsQueryable();
        if (!string.IsNullOrWhiteSpace(request.Search))
        {
            var texto = request.Search.Trim();
            userQuery = userQuery.Where(u =>
                EF.Functions.ILike(u.Email ?? string.Empty, $"%{texto}%") ||
                EF.Functions.ILike(u.UserName ?? string.Empty, $"%{texto}%") ||
                db.UserClaims.Any(c => c.UserId == u.Id &&
                    (c.ClaimType == "given_name" || c.ClaimType == "family_name" || c.ClaimType == "maternal_family_name") &&
                    EF.Functions.ILike(c.ClaimValue ?? string.Empty, $"%{texto}%")));
        }

        totalUsers = await userQuery.CountAsync();
        var totalPages = Math.Max(1, (int)Math.Ceiling(totalUsers / (double)request.PageSize));
        request.Page = Math.Min(Math.Max(1, request.Page), totalPages);
        var list = new List<UserWithRolesVm>();
        foreach (var u in await userQuery.OrderBy(u => u.Email).ThenBy(u => u.Id).Skip((request.Page - 1) * request.PageSize).Take(request.PageSize).ToListAsync())
        {
            var roles = await UserManager.GetRolesAsync(u);
            var claims = await UserManager.GetClaimsAsync(u);
            var nombre = claims.FirstOrDefault(c => c.Type == "given_name")?.Value;
            var apellido = claims.FirstOrDefault(c => c.Type == "family_name")?.Value;
            var apellidoMaterno = claims.FirstOrDefault(c => c.Type == "maternal_family_name")?.Value;
            list.Add(new UserWithRolesVm
            {
                Id = u.Id,
                UserName = u.UserName,
                Email = u.Email,
                Nombre = nombre,
                Apellido = apellido,
                ApellidoMaterno = apellidoMaterno,
                Roles = roles
            });

            roleSelection[u.Id] = roles.FirstOrDefault() ?? allRoles.FirstOrDefault() ?? BodegaDESAM.Auth.AppRoles.Lectura;
            bodegasPorUsuario[u.Id] = await UsuarioBodegaService.GetAsignadasAsync(u.Id);
        }

        users = list;
        userPage = new PagedResult<UserWithRolesVm>(users, totalUsers, request.Page, request.PageSize);
        original = users.ToDictionary(
            u => u.Id,
            u => new UserWithRolesVm { Id = u.Id, UserName = u.UserName, Email = u.Email, Nombre = u.Nombre, Apellido = u.Apellido, ApellidoMaterno = u.ApellidoMaterno, Roles = u.Roles.ToList() });
        }
        catch (Exception ex)
        {
            users = new();
            error = ex.Message.Contains("usuario_bodega", StringComparison.OrdinalIgnoreCase)
                ? "Falta aplicar la migración de multi-bodega en la base de datos. Ejecuta las migraciones y vuelve a cargar la página."
                : "No fue posible cargar los usuarios. " + ex.Message;
        }
    }

    async Task BuscarAsync(string? texto) { request.Search = texto; request.Page = 1; await LoadAsync(); }
    async Task CambiarPaginaAsync(int pagina) { request.Page = pagina; await LoadAsync(); }
    async Task CambiarTamanoAsync(int tamano) { request.PageSize = tamano; request.Page = 1; await LoadAsync(); }

    bool EstaAsignada(string idUsuario, int idBodega) => bodegasPorUsuario.TryGetValue(idUsuario, out var ids) && ids.Contains(idBodega);

    async Task CambiarBodegaAsync(string idUsuario, int idBodega, ChangeEventArgs args)
    {
        var seleccionadas = bodegasPorUsuario.TryGetValue(idUsuario, out var actuales) ? new HashSet<int>(actuales) : new();
        var marcada = args.Value is bool valor && valor;
        if (marcada) seleccionadas.Add(idBodega); else seleccionadas.Remove(idBodega);
        await UsuarioBodegaService.ReemplazarAsync(idUsuario, seleccionadas);
        bodegasPorUsuario[idUsuario] = seleccionadas;
    }

    void EditUser(string userId)
    {
        var u = users?.FirstOrDefault(x => x.Id == userId);
        if (u is null)
            return;

        u.IsEditing = true;
    }

    void CancelEdit(string userId)
    {
        if (users is null)
            return;

        var u = users.FirstOrDefault(x => x.Id == userId);
        if (u is null)
            return;

        if (original.TryGetValue(userId, out var o))
        {
            u.UserName = o.UserName;
            u.Email = o.Email;
            u.Nombre = o.Nombre;
            u.Apellido = o.Apellido;
            u.ApellidoMaterno = o.ApellidoMaterno;
        }

        u.IsEditing = false;
    }

    async Task SaveUserAsync(string userId)
    {
        using var loading = LoadingState.Begin();
        error = null;
        success = null;
        busy = true;

        try
        {
            var vm = users?.FirstOrDefault(x => x.Id == userId);
            if (vm is null)
                return;

            var user = await UserManager.FindByIdAsync(userId);
            if (user is null)
            {
                error = "Usuario no encontrado.";
                return;
            }

            var email = vm.Email?.Trim();
            if (string.IsNullOrWhiteSpace(email))
            {
                error = "Email requerido.";
                return;
            }

            user.Email = email;
            user.UserName = email;

            var res = await UserManager.UpdateAsync(user);
            if (!res.Succeeded)
            {
                error = string.Join(" ", res.Errors.Select(e => e.Description));
                return;
            }

            var claims = await UserManager.GetClaimsAsync(user);
            await UpsertClaimAsync(user, claims, "given_name", vm.Nombre?.Trim());
            await UpsertClaimAsync(user, claims, "family_name", vm.Apellido?.Trim());
            await UpsertClaimAsync(user, claims, "maternal_family_name", vm.ApellidoMaterno?.Trim());

            success = "Usuario actualizado.";
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    async Task UpsertClaimAsync(IdentityUser user, IList<Claim> claims, string type, string? value)
    {
        var existing = claims.FirstOrDefault(c => c.Type == type);

        if (string.IsNullOrWhiteSpace(value))
        {
            if (existing is not null)
                await UserManager.RemoveClaimAsync(user, existing);
            return;
        }

        var updated = new Claim(type, value);
        if (existing is null)
            await UserManager.AddClaimAsync(user, updated);
        else
            await UserManager.ReplaceClaimAsync(user, existing, updated);
    }

    string GetSelectedRole(string userId)
    {
        if (roleSelection.TryGetValue(userId, out var role) && !string.IsNullOrWhiteSpace(role))
            return role;

        return allRoles.FirstOrDefault() ?? BodegaDESAM.Auth.AppRoles.Lectura;
    }

    void SetSelectedRole(string userId, string? role)
    {
        roleSelection[userId] = string.IsNullOrWhiteSpace(role)
            ? (allRoles.FirstOrDefault() ?? BodegaDESAM.Auth.AppRoles.Lectura)
            : role;
    }

    async Task CreateUserAsync()
    {
        using var loading = LoadingState.Begin();
        error = null;
        success = null;
        busy = true;

        try
        {
            var email = create.Email?.Trim();
            if (string.IsNullOrWhiteSpace(email))
            {
                error = "Email requerido.";
                return;
            }

            var existing = await UserManager.FindByEmailAsync(email);
            if (existing is not null)
            {
                error = "Ya existe un usuario con ese email.";
                return;
            }

            var user = new IdentityUser
            {
                UserName = email,
                Email = email,
                EmailConfirmed = true
            };

            var created = await UserManager.CreateAsync(user, create.Password ?? string.Empty);
            if (!created.Succeeded)
            {
                error = string.Join(" ", created.Errors.Select(e => e.Description));
                return;
            }

            if (!string.IsNullOrWhiteSpace(create.Role))
            {
                await UserManager.AddToRoleAsync(user, create.Role);
                if (create.Role != BodegaDESAM.Auth.AppRoles.Admin)
                {
                    var principal = (await BodegaService.GetAllAsync()).FirstOrDefault(b => b.EsPrincipal);
                    if (principal is not null)
                        await UsuarioBodegaService.ReemplazarAsync(user.Id, new[] { principal.Id });
                }
            }

            var nombre = create.Nombre?.Trim();
            var apellido = create.Apellido?.Trim();
            var apellidoMaterno = create.ApellidoMaterno?.Trim();
            if (!string.IsNullOrWhiteSpace(nombre))
                await UserManager.AddClaimAsync(user, new Claim("given_name", nombre));
            if (!string.IsNullOrWhiteSpace(apellido))
                await UserManager.AddClaimAsync(user, new Claim("family_name", apellido));
            if (!string.IsNullOrWhiteSpace(apellidoMaterno))
                await UserManager.AddClaimAsync(user, new Claim("maternal_family_name", apellidoMaterno));

            success = "Usuario creado.";
            create.Email = string.Empty;
            create.Password = string.Empty;
            create.Nombre = string.Empty;
            create.Apellido = string.Empty;
            create.ApellidoMaterno = string.Empty;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    async Task AddRoleAsync(string userId)
    {
        await UpdateRoleAsync(userId, add: true);
    }

    async Task RemoveRoleAsync(string userId)
    {
        await UpdateRoleAsync(userId, add: false);
    }

    async Task UpdateRoleAsync(string userId, bool add)
    {
        using var loading = LoadingState.Begin();
        error = null;
        success = null;
        busy = true;

        try
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (user is null)
            {
                error = "Usuario no encontrado.";
                return;
            }

            if (!roleSelection.TryGetValue(userId, out var role) || string.IsNullOrWhiteSpace(role))
            {
                error = "Rol no seleccionado.";
                return;
            }

            var currentRoles = await UserManager.GetRolesAsync(user);

            if (add)
            {
                if (currentRoles.Contains(role))
                {
                    success = "El usuario ya tiene ese rol.";
                    return;
                }

                var res = await UserManager.AddToRoleAsync(user, role);
                if (!res.Succeeded)
                {
                    error = string.Join(" ", res.Errors.Select(e => e.Description));
                    return;
                }

                success = "Rol agregado.";
            }
            else
            {
                if (!currentRoles.Contains(role))
                {
                    success = "El usuario no tiene ese rol.";
                    return;
                }

                if (role == BodegaDESAM.Auth.AppRoles.Admin && currentRoles.Count(r => r == BodegaDESAM.Auth.AppRoles.Admin) == 1)
                {
                    var admins = new List<IdentityUser>();
                    foreach (var u in UserManager.Users.ToList())
                    {
                        if (await UserManager.IsInRoleAsync(u, BodegaDESAM.Auth.AppRoles.Admin))
                            admins.Add(u);
                    }

                    if (admins.Count <= 1 && await UserManager.IsInRoleAsync(user, BodegaDESAM.Auth.AppRoles.Admin))
                    {
                        error = "No se puede quitar el rol Admin al último administrador.";
                        return;
                    }
                }

                var res = await UserManager.RemoveFromRoleAsync(user, role);
                if (!res.Succeeded)
                {
                    error = string.Join(" ", res.Errors.Select(e => e.Description));
                    return;
                }

                success = "Rol quitado.";
            }

            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    async Task ResetPasswordAsync(string userId)
    {
        using var loading = LoadingState.Begin();
        error = null;
        success = null;
        busy = true;

        try
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (user is null)
            {
                error = "Usuario no encontrado.";
                return;
            }

            const string passwordCharacters = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@$%";
            var temporaryPassword = RandomNumberGenerator.GetString(passwordCharacters, 20);
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var res = await UserManager.ResetPasswordAsync(user, token, temporaryPassword);
            if (!res.Succeeded)
            {
                error = string.Join(" ", res.Errors.Select(e => e.Description));
                return;
            }

            await UserManager.SetLockoutEndDateAsync(user, null);
            success = $"Contraseña temporal generada: {temporaryPassword}. Entrégala al usuario por un canal seguro.";
        }
        finally
        {
            busy = false;
        }
    }

}
