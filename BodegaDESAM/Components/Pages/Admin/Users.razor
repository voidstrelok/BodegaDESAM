@page "/admin/usuarios"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.Admin)]

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using BodegaDESAM.Models.Admin
@using BodegaDESAM.Services
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using System.Security.Cryptography

@inject UserManager<IdentityUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject BodegaService BodegaService
@inject UsuarioBodegaService UsuarioBodegaService
@inject IDbContextFactory<PostgresDataContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<main class="user-hub">
    <header class="user-hub-header">
        <div class="user-hub-title">
            <span class="user-hub-mark"><i class="bi bi-person-gear"></i></span>
            <div><span class="user-hub-eyebrow">Administración</span><h3>Usuarios</h3><p>Gestiona las personas que pueden ingresar a Bodega DESAM.</p></div>
        </div>
        <AuthorizeView><Authorized Context="auth"><span class="user-hub-operator"><i class="bi bi-person-circle"></i>@(auth.User.FindFirst("given_name")?.Value ?? auth.User.Identity?.Name)</span></Authorized></AuthorizeView>
    </header>

    @if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger user-hub-alert" role="alert"><i class="bi bi-exclamation-circle"></i>@error</div> }
    @if (!string.IsNullOrWhiteSpace(success)) { <div class="alert alert-success user-hub-alert" role="alert"><i class="bi bi-check-circle"></i>@success</div> }

    <section class="user-hub-overview" aria-label="Resumen">
        <div><span><i class="bi bi-people"></i>Usuarios</span><strong>@totalUsers</strong><small>registrados en el sistema</small></div>
        <div><span><i class="bi bi-person-check"></i>Acceso activo</span><strong>@(users?.Count(u => u.AccesoActivo) ?? 0)</strong><small>en los resultados actuales</small></div>
        <div><span><i class="bi bi-buildings"></i>Bodegas</span><strong>@bodegas.Count</strong><small>disponibles para asignar</small></div>
    </section>

    <section class="user-hub-create">
        <div class="user-hub-section-title"><span><i class="bi bi-person-plus"></i></span><div><h4>Agregar persona</h4><p>Su rol y sus bodegas se pueden ajustar en cualquier momento.</p></div></div>
        <EditForm Model="create" OnValidSubmit="CreateUserAsync">
            <DataAnnotationsValidator /><ValidationSummary />
            <div class="user-hub-form-grid">
                <label><span>Nombre</span><InputText class="form-control" @bind-Value="create.Nombre" /><ValidationMessage For="() => create.Nombre" /></label>
                <label><span>Apellido paterno</span><InputText class="form-control" @bind-Value="create.Apellido" /><ValidationMessage For="() => create.Apellido" /></label>
                <label><span>Apellido materno</span><InputText class="form-control" @bind-Value="create.ApellidoMaterno" /><ValidationMessage For="() => create.ApellidoMaterno" /></label>
                <label><span>Correo electrónico</span><InputText class="form-control" @bind-Value="create.Email" placeholder="nombre@desam.cl" /><ValidationMessage For="() => create.Email" /></label>
                <label><span>Clave inicial</span><InputText class="form-control" type="password" @bind-Value="create.Password" placeholder="Mínimo 8 caracteres" /><ValidationMessage For="() => create.Password" /></label>
                <label><span>Rol inicial</span><InputSelect class="form-select" @bind-Value="create.Role">@foreach (var r in allRoles) { <option value="@r">@r</option> }</InputSelect><ValidationMessage For="() => create.Role" /></label>
            </div>
            <div class="user-hub-create-footer"><small><i class="bi bi-info-circle"></i> La clave debe incluir mayúscula, minúscula y número.</small><button class="btn btn-primary" type="submit" disabled="@busy"><i class="bi bi-plus-lg"></i>Crear usuario</button></div>
        </EditForm>
    </section>

    <section class="user-hub-directory">
        <div class="user-hub-directory-head"><div><span class="user-hub-eyebrow">Directorio</span><h4>Personas y permisos</h4></div><div class="user-hub-search"><SearchBox Value="@request.Search" ValueChanged="BuscarAsync" Placeholder="Buscar por nombre o correo..." AriaLabel="Buscar usuarios" /></div></div>
        @if (users is null)
        { <div class="user-hub-empty"><i class="bi bi-arrow-repeat"></i>Cargando usuarios...</div> }
        else if (users.Count == 0)
        { <div class="user-hub-empty"><i class="bi bi-people"></i>No se encontraron usuarios.</div> }
        else
        {
            <div class="user-hub-cards">
            @foreach (var u in users)
            {
                <article class="user-person-card @(u.IsEditing ? "is-editing" : "")">
                    <div class="user-person-top">
                        <div class="user-person-identity"><span class="user-person-avatar">@ObtenerIniciales(u)</span><div><h5>@($"{u.Nombre} {u.Apellido} {u.ApellidoMaterno}".Trim())</h5><p>@(!string.IsNullOrWhiteSpace(u.Email) ? u.Email : u.UserName)</p></div></div>
                        <span class="user-person-status @(u.AccesoActivo ? "enabled" : "disabled")"><i class="bi @(u.AccesoActivo ? "bi-check-circle-fill" : "bi-pause-circle-fill")"></i>@(u.AccesoActivo ? "Activo" : "Desactivado")</span>
                    </div>

                    @if (u.IsEditing)
                    {
                        <div class="user-person-edit">
                            <label><span>Correo</span><InputText class="form-control form-control-sm" @bind-Value="u.Email" /></label>
                            <div class="user-person-edit-grid"><label><span>Nombre</span><InputText class="form-control form-control-sm" @bind-Value="u.Nombre" /></label><label><span>Apellido paterno</span><InputText class="form-control form-control-sm" @bind-Value="u.Apellido" /></label></div>
                            <div class="user-person-edit-grid"><label><span>Apellido materno</span><InputText class="form-control form-control-sm" @bind-Value="u.ApellidoMaterno" /></label><label><span>Nueva clave (opcional)</span><InputText class="form-control form-control-sm" type="password" @bind-Value="u.NuevaClave" placeholder="Mínimo 8 caracteres" /><small>Incluye mayúscula, minúscula y número.</small></label></div>
                        </div>
                    }

                    <div class="user-person-block"><span class="user-person-label"><i class="bi bi-shield"></i>Roles actuales</span><div class="user-person-tags">@if (u.Roles.Count == 0) { <span class="user-person-muted">Sin roles asignados</span> } else { @foreach (var role in u.Roles) { <span class="user-person-tag">@role</span> } }</div></div>
                    <div class="user-person-block"><span class="user-person-label"><i class="bi bi-box-seam"></i>Bodegas autorizadas</span><div class="user-person-warehouses">@if (u.Roles.Contains(BodegaDESAM.Auth.AppRoles.Admin)) { <span class="user-person-all"><i class="bi bi-shield-check"></i>Acceso a todas las bodegas</span> } else { @foreach (var bodega in bodegas) { <label class="user-person-warehouse"><input type="checkbox" checked="@EstaAsignada(u.Id, bodega.Id)" @onchange="e => CambiarBodegaAsync(u.Id, bodega.Id, e)" /><span>@bodega.Nombre</span></label> } }</div></div>
                    <div class="user-person-actions">
                        <select class="form-select form-select-sm" value="@GetSelectedRole(u.Id)" @onchange="e => SetSelectedRole(u.Id, e.Value?.ToString())" aria-label="Rol a gestionar">@foreach (var r in allRoles) { <option value="@r">@r</option> }</select>
                        <div class="user-person-buttons">
                            @if (u.IsEditing) { <button class="btn btn-primary btn-sm" disabled="@busy" @onclick="() => SaveUserAsync(u.Id)"><i class="bi bi-check-lg"></i>Guardar</button><button class="btn btn-light btn-sm" disabled="@busy" @onclick="() => CancelEdit(u.Id)">Cancelar</button> } else { <button class="btn btn-light btn-sm" disabled="@busy" @onclick="() => EditUser(u.Id)"><i class="bi bi-pencil"></i>Editar</button><button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => EditUser(u.Id)" title="Editar la nueva clave de acceso"><i class="bi bi-key"></i>Clave</button> }
                            <button class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => AddRoleAsync(u.Id)" title="Agregar el rol seleccionado"><i class="bi bi-plus-lg"></i>Rol</button><button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => RemoveRoleAsync(u.Id)" title="Quitar el rol seleccionado"><i class="bi bi-dash-lg"></i>Rol</button>
                            <button class="btn @(u.AccesoActivo ? "btn-outline-danger" : "btn-outline-success") btn-sm" disabled="@busy" @onclick="() => CambiarAccesoAsync(u.Id, !u.AccesoActivo)"><i class="bi @(u.AccesoActivo ? "bi-slash-circle" : "bi-check-circle")"></i>@(u.AccesoActivo ? "Desactivar" : "Activar")</button>
                        </div>
                    </div>
                </article>
            }
            </div>
            @if (userPage is not null) { <PaginationControls Page="@userPage.Page" TotalPages="@userPage.TotalPages" TotalItems="@userPage.TotalItems" PageSize="@userPage.PageSize" PageChanged="CambiarPaginaAsync" PageSizeChanged="CambiarTamanoAsync" /> }
        }
    </section>
</main>

@if (mostrarVistaLegacy)
{
<section class="users-hero">
    <div class="users-hero-copy">
        <div class="users-hero-icon"><i class="bi bi-people-fill"></i></div>
        <div>
            <span class="movement-kind">Administración</span>
            <h3 class="page-title mb-1">Usuarios y accesos</h3>
            <p class="page-subtitle mb-0">Centraliza perfiles, permisos y acceso a las bodegas.</p>
        </div>
    </div>
    <div class="users-hero-meta">
        <AuthorizeView>
            <Authorized Context="auth">
                <span class="users-session"><i class="bi bi-person-check"></i>@(auth.User.FindFirst("given_name")?.Value ?? auth.User.Identity?.Name)</span>
            </Authorized>
        </AuthorizeView>
        @if (users is not null) { <span class="users-count"><i class="bi bi-people"></i>@totalUsers registrados</span> }
    </div>
</section>

@if (users is not null)
{
    <section class="users-summary" aria-label="Resumen de usuarios">
        <div class="users-summary-item"><span class="users-summary-icon primary"><i class="bi bi-people"></i></span><div><strong>@totalUsers</strong><span>Usuarios registrados</span></div></div>
        <div class="users-summary-item"><span class="users-summary-icon success"><i class="bi bi-person-check"></i></span><div><strong>@users.Count(u => u.AccesoActivo)</strong><span>Activos en esta página</span></div></div>
        <div class="users-summary-item"><span class="users-summary-icon info"><i class="bi bi-box-seam"></i></span><div><strong>@bodegas.Count</strong><span>Bodegas disponibles</span></div></div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (!string.IsNullOrWhiteSpace(success))
{
    <div class="alert alert-success" role="alert">@success</div>
}

<div class="page-toolbar users-toolbar mb-3"><div><span class="users-toolbar-label">Directorio de usuarios</span><SearchBox Value="@request.Search" ValueChanged="BuscarAsync" Placeholder="Buscar por email, usuario o nombre..." AriaLabel="Buscar usuarios" /></div></div>

<div class="card-section users-create-card p-3 mb-4">
    <div class="users-section-heading"><div class="users-section-icon"><i class="bi bi-person-plus-fill"></i></div><div><span class="movement-kind">Incorporación</span><h5>Crear usuario</h5><p>Define su identidad, clave y rol inicial. Las bodegas se ajustan después.</p></div></div>
    <EditForm Model="create" OnValidSubmit="CreateUserAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-3">
            <div class="col-12 col-md-3">
                <label class="form-label">Nombre</label>
                <InputText class="form-control" @bind-Value="create.Nombre" />
                <ValidationMessage For="() => create.Nombre" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Apellido paterno</label>
                <InputText class="form-control" @bind-Value="create.Apellido" />
                <ValidationMessage For="() => create.Apellido" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label">Apellido materno</label>
                <InputText class="form-control" @bind-Value="create.ApellidoMaterno" />
                <ValidationMessage For="() => create.ApellidoMaterno" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="create.Email" placeholder="usuario@dominio.cl" />
                <ValidationMessage For="() => create.Email" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Password</label>
                <InputText class="form-control" type="password" @bind-Value="create.Password" placeholder="••••••••" />
                <ValidationMessage For="() => create.Password" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Rol inicial</label>
                <InputSelect class="form-select" @bind-Value="create.Role">
                    @foreach (var r in allRoles)
                    {
                        <option value="@r">@r</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => create.Role" />
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary users-create-button" type="submit" disabled="@busy"><i class="bi bi-person-plus me-1"></i>Crear usuario</button>
        </div>
    </EditForm>
</div>

@if (users is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="card-section users-table-card">
        <div class="users-table-heading"><div><span class="movement-kind">Directorio</span><h5>Personas con acceso</h5></div><span>@totalUsers resultado(s)</span></div>
        <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0 users-table">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Acceso</th>
                    <th>Bodegas</th>
                    <th>Roles</th>
                    <th class="users-actions-heading">Gestión</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in users)
                {
                    <tr>
                        <td class="users-warehouses-cell">
                            @if (!u.IsEditing)
                            {
                                <div class="users-identity">
                                    <span class="users-avatar">@ObtenerIniciales(u)</span>
                                    <div>
                                        <div class="fw-semibold">@($"{u.Nombre} {u.Apellido}".Trim())</div>
                                        <div class="users-email">@(!string.IsNullOrWhiteSpace(u.Email) ? u.Email : u.UserName)</div>
                                        @if (!string.IsNullOrWhiteSpace(u.ApellidoMaterno)) { <div class="users-secondary">@u.ApellidoMaterno</div> }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="row g-2">
                                    <div class="col-12">
                                        <InputText class="form-control form-control-sm" @bind-Value="u.Email" placeholder="Email" />
                                    </div>
                                    <div class="col-6">
                                        <InputText class="form-control form-control-sm" @bind-Value="u.Nombre" placeholder="Nombre" />
                                    </div>
                                    <div class="col-6">
                                        <InputText class="form-control form-control-sm" @bind-Value="u.Apellido" placeholder="Apellido paterno" />
                                    </div>
                                    <div class="col-6">
                                        <InputText class="form-control form-control-sm" @bind-Value="u.ApellidoMaterno" placeholder="Apellido materno" />
                                    </div>
                                    <div class="col-12">
                                        <InputText class="form-control form-control-sm" type="password" @bind-Value="u.NuevaClave" placeholder="Nueva clave (opcional)" />
                                        <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula y número.</div>
                                    </div>
                                    <div class="col-12">
                                        <div class="text-muted small">@u.Id</div>
                                    </div>
                                </div>
                            }
                        </td>
                        <td>
                            @if (u.AccesoActivo)
                            {
                                <span class="users-status active"><i class="bi bi-check-circle-fill"></i>Activo</span>
                            }
                            else
                            {
                                <span class="users-status inactive"><i class="bi bi-pause-circle-fill"></i>Desactivado</span>
                            }
                        </td>
                        <td>
                            @if (u.Roles.Contains(BodegaDESAM.Auth.AppRoles.Admin))
                            {
                                <span class="users-all-warehouses"><i class="bi bi-shield-check"></i>Todas las bodegas</span>
                            }
                            else
                            {
                                @foreach (var bodega in bodegas)
                                {
                                    <div class="form-check form-check-inline users-warehouse-check">
                                        <input class="form-check-input" type="checkbox" checked="@EstaAsignada(u.Id, bodega.Id)" @onchange="e => CambiarBodegaAsync(u.Id, bodega.Id, e)" id="@($"ub-{u.Id}-{bodega.Id}")" />
                                        <label class="form-check-label small" for="@($"ub-{u.Id}-{bodega.Id}")">@bodega.Nombre</label>
                                    </div>
                                }
                            }
                        </td>
                        <td class="users-roles-cell">
                            @if (u.Roles.Count == 0)
                            {
                                <span class="text-muted">(sin roles)</span>
                            }
                            else
                            {
                                @foreach (var role in u.Roles) { <span class="users-role">@role</span> }
                            }
                        </td>
                        <td class="users-actions-cell">
                            <div class="users-actions">
                                <div class="users-role-control">
                                    <label class="visually-hidden" for="@($"role-{u.Id}")">Rol a gestionar</label>
                                    <select id="@($"role-{u.Id}")" class="form-select form-select-sm" value="@GetSelectedRole(u.Id)" @onchange="e => SetSelectedRole(u.Id, e.Value?.ToString())">
                                    @foreach (var r in allRoles)
                                    {
                                        <option value="@r">@r</option>
                                    }
                                    </select>
                                </div>

                                <div class="users-action-row">
                                @if (!u.IsEditing)
                                {
                                    <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => EditUser(u.Id)"><i class="bi bi-pencil"></i><span>Editar</span></button>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-sm" disabled="@busy" @onclick="() => SaveUserAsync(u.Id)"><i class="bi bi-check-lg"></i><span>Guardar</span></button>
                                    <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => CancelEdit(u.Id)">Cancelar</button>
                                }

                                <button class="btn btn-outline-primary btn-sm" disabled="@busy" @onclick="() => AddRoleAsync(u.Id)" title="Agrega el rol seleccionado"><i class="bi bi-plus-lg"></i><span>Rol</span></button>
                                <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => RemoveRoleAsync(u.Id)" title="Quita el rol seleccionado"><i class="bi bi-dash-lg"></i><span>Rol</span></button>

                                <button class="btn @(u.AccesoActivo ? "btn-outline-danger" : "btn-outline-success") btn-sm" disabled="@busy" @onclick="() => CambiarAccesoAsync(u.Id, !u.AccesoActivo)">
                                    <i class="bi @(u.AccesoActivo ? "bi-slash-circle" : "bi-check-circle")"></i><span>@(u.AccesoActivo ? "Desactivar" : "Activar")</span>
                                </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
        @if (userPage is not null) { <PaginationControls Page="@userPage.Page" TotalPages="@userPage.TotalPages" TotalItems="@userPage.TotalItems" PageSize="@userPage.PageSize" PageChanged="CambiarPaginaAsync" PageSizeChanged="CambiarTamanoAsync" /> }
    </div>
}
}

@code {
    List<UserWithRolesVm>? users;
    PagedResult<UserWithRolesVm>? userPage;
    readonly PageRequest request = new();
    int totalUsers;
    List<string> allRoles = new();
    Dictionary<string, string> roleSelection = new();
    Dictionary<string, UserWithRolesVm> original = new();
    List<Bodega> bodegas = new();
    Dictionary<string, HashSet<int>> bodegasPorUsuario = new();

    string? error;
    string? success;
    bool busy;
    bool mostrarVistaLegacy = false;

    readonly CreateUserVm create = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        using var loading = LoadingState.Begin();
        error = null;
        success = null;

        try
        {
        allRoles = RoleManager.Roles.Select(r => r.Name!).OrderBy(r => r).ToList();
        bodegas = await BodegaService.GetAllAsync();
        if (allRoles.Count == 0)
            allRoles = new() { BodegaDESAM.Auth.AppRoles.Admin, BodegaDESAM.Auth.AppRoles.Bodega, BodegaDESAM.Auth.AppRoles.Lectura };

        if (string.IsNullOrWhiteSpace(create.Role))
            create.Role = allRoles.FirstOrDefault() ?? BodegaDESAM.Auth.AppRoles.Lectura;

        using var db = DbFactory.CreateDbContext();
        var userQuery = db.Users.AsNoTracking().AsQueryable();
        if (!string.IsNullOrWhiteSpace(request.Search))
        {
            var texto = request.Search.Trim();
            userQuery = userQuery.Where(u =>
                EF.Functions.ILike(u.Email ?? string.Empty, $"%{texto}%") ||
                EF.Functions.ILike(u.UserName ?? string.Empty, $"%{texto}%") ||
                db.UserClaims.Any(c => c.UserId == u.Id &&
                    (c.ClaimType == "given_name" || c.ClaimType == "family_name" || c.ClaimType == "maternal_family_name") &&
                    EF.Functions.ILike(c.ClaimValue ?? string.Empty, $"%{texto}%")));
        }

        totalUsers = await userQuery.CountAsync();
        var totalPages = Math.Max(1, (int)Math.Ceiling(totalUsers / (double)request.PageSize));
        request.Page = Math.Min(Math.Max(1, request.Page), totalPages);
        var list = new List<UserWithRolesVm>();
        foreach (var u in await userQuery.OrderBy(u => u.Email).ThenBy(u => u.Id).Skip((request.Page - 1) * request.PageSize).Take(request.PageSize).ToListAsync())
        {
            var roles = await UserManager.GetRolesAsync(u);
            var claims = await UserManager.GetClaimsAsync(u);
            var nombre = claims.FirstOrDefault(c => c.Type == "given_name")?.Value;
            var apellido = claims.FirstOrDefault(c => c.Type == "family_name")?.Value;
            var apellidoMaterno = claims.FirstOrDefault(c => c.Type == "maternal_family_name")?.Value;
            list.Add(new UserWithRolesVm
            {
                Id = u.Id,
                UserName = u.UserName,
                Email = u.Email,
                Nombre = nombre,
                Apellido = apellido,
                ApellidoMaterno = apellidoMaterno,
                AccesoActivo = TieneAccesoActivo(u),
                Roles = roles
            });

            roleSelection[u.Id] = roles.FirstOrDefault() ?? allRoles.FirstOrDefault() ?? BodegaDESAM.Auth.AppRoles.Lectura;
            bodegasPorUsuario[u.Id] = await UsuarioBodegaService.GetAsignadasAsync(u.Id);
        }

        users = list;
        userPage = new PagedResult<UserWithRolesVm>(users, totalUsers, request.Page, request.PageSize);
        original = users.ToDictionary(
            u => u.Id,
            u => new UserWithRolesVm { Id = u.Id, UserName = u.UserName, Email = u.Email, Nombre = u.Nombre, Apellido = u.Apellido, ApellidoMaterno = u.ApellidoMaterno, AccesoActivo = u.AccesoActivo, Roles = u.Roles.ToList() });
        }
        catch (Exception ex)
        {
            users = new();
            error = ex.Message.Contains("usuario_bodega", StringComparison.OrdinalIgnoreCase)
                ? "Falta aplicar la migración de multi-bodega en la base de datos. Ejecuta las migraciones y vuelve a cargar la página."
                : "No fue posible cargar los usuarios. " + ex.Message;
        }
    }

    async Task BuscarAsync(string? texto) { request.Search = texto; request.Page = 1; await LoadAsync(); }
    async Task CambiarPaginaAsync(int pagina) { request.Page = pagina; await LoadAsync(); }
    async Task CambiarTamanoAsync(int tamano) { request.PageSize = tamano; request.Page = 1; await LoadAsync(); }

    static string ObtenerIniciales(UserWithRolesVm usuario)
    {
        var nombre = $"{usuario.Nombre} {usuario.Apellido}".Trim();
        if (!string.IsNullOrWhiteSpace(nombre))
        {
            var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return string.Concat(partes.Take(2).Select(p => char.ToUpperInvariant(p[0])));
        }

        var identificador = usuario.Email ?? usuario.UserName ?? "?";
        return char.ToUpperInvariant(identificador[0]).ToString();
    }

    bool EstaAsignada(string idUsuario, int idBodega) => bodegasPorUsuario.TryGetValue(idUsuario, out var ids) && ids.Contains(idBodega);

    async Task CambiarBodegaAsync(string idUsuario, int idBodega, ChangeEventArgs args)
    {
        var seleccionadas = bodegasPorUsuario.TryGetValue(idUsuario, out var actuales) ? new HashSet<int>(actuales) : new();
        var marcada = args.Value is bool valor && valor;
        if (marcada) seleccionadas.Add(idBodega); else seleccionadas.Remove(idBodega);
        await UsuarioBodegaService.ReemplazarAsync(idUsuario, seleccionadas);
        bodegasPorUsuario[idUsuario] = seleccionadas;
    }

    void EditUser(string userId)
    {
        var u = users?.FirstOrDefault(x => x.Id == userId);
        if (u is null)
            return;

        u.IsEditing = true;
    }

    void CancelEdit(string userId)
    {
        if (users is null)
            return;

        var u = users.FirstOrDefault(x => x.Id == userId);
        if (u is null)
            return;

        if (original.TryGetValue(userId, out var o))
        {
            u.UserName = o.UserName;
            u.Email = o.Email;
            u.Nombre = o.Nombre;
            u.Apellido = o.Apellido;
            u.ApellidoMaterno = o.ApellidoMaterno;
            u.NuevaClave = null;
        }

        u.IsEditing = false;
    }

    async Task SaveUserAsync(string userId)
    {
        using var loading = LoadingState.Begin();
        error = null;
        success = null;
        busy = true;

        try
        {
            var vm = users?.FirstOrDefault(x => x.Id == userId);
            if (vm is null)
                return;

            var user = await UserManager.FindByIdAsync(userId);
            if (user is null)
            {
                error = "Usuario no encontrado.";
                return;
            }

            var email = vm.Email?.Trim();
            if (string.IsNullOrWhiteSpace(email))
            {
                error = "Email requerido.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(vm.NuevaClave))
            {
                var token = await UserManager.GeneratePasswordResetTokenAsync(user);
                var cambioClave = await UserManager.ResetPasswordAsync(user, token, vm.NuevaClave);
                if (!cambioClave.Succeeded)
                {
                    error = string.Join(" ", cambioClave.Errors.Select(e => e.Description));
                    return;
                }

                await UserManager.UpdateSecurityStampAsync(user);
            }

            user.Email = email;
            user.UserName = email;

            var res = await UserManager.UpdateAsync(user);
            if (!res.Succeeded)
            {
                error = string.Join(" ", res.Errors.Select(e => e.Description));
                return;
            }

            var claims = await UserManager.GetClaimsAsync(user);
            await UpsertClaimAsync(user, claims, "given_name", vm.Nombre?.Trim());
            await UpsertClaimAsync(user, claims, "family_name", vm.Apellido?.Trim());
            await UpsertClaimAsync(user, claims, "maternal_family_name", vm.ApellidoMaterno?.Trim());

            success = string.IsNullOrWhiteSpace(vm.NuevaClave) ? "Usuario actualizado." : "Usuario y clave actualizados.";
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    async Task UpsertClaimAsync(IdentityUser user, IList<Claim> claims, string type, string? value)
    {
        var existing = claims.FirstOrDefault(c => c.Type == type);

        if (string.IsNullOrWhiteSpace(value))
        {
            if (existing is not null)
                await UserManager.RemoveClaimAsync(user, existing);
            return;
        }

        var updated = new Claim(type, value);
        if (existing is null)
            await UserManager.AddClaimAsync(user, updated);
        else
            await UserManager.ReplaceClaimAsync(user, existing, updated);
    }

    string GetSelectedRole(string userId)
    {
        if (roleSelection.TryGetValue(userId, out var role) && !string.IsNullOrWhiteSpace(role))
            return role;

        return allRoles.FirstOrDefault() ?? BodegaDESAM.Auth.AppRoles.Lectura;
    }

    void SetSelectedRole(string userId, string? role)
    {
        roleSelection[userId] = string.IsNullOrWhiteSpace(role)
            ? (allRoles.FirstOrDefault() ?? BodegaDESAM.Auth.AppRoles.Lectura)
            : role;
    }

    async Task CreateUserAsync()
    {
        using var loading = LoadingState.Begin();
        error = null;
        success = null;
        busy = true;

        try
        {
            var email = create.Email?.Trim();
            if (string.IsNullOrWhiteSpace(email))
            {
                error = "Email requerido.";
                return;
            }

            var existing = await UserManager.FindByEmailAsync(email);
            if (existing is not null)
            {
                error = "Ya existe un usuario con ese email.";
                return;
            }

            var user = new IdentityUser
            {
                UserName = email,
                Email = email,
                EmailConfirmed = true
            };

            var created = await UserManager.CreateAsync(user, create.Password ?? string.Empty);
            if (!created.Succeeded)
            {
                error = string.Join(" ", created.Errors.Select(e => e.Description));
                return;
            }

            if (!string.IsNullOrWhiteSpace(create.Role))
            {
                await UserManager.AddToRoleAsync(user, create.Role);
                if (create.Role != BodegaDESAM.Auth.AppRoles.Admin)
                {
                    var principal = (await BodegaService.GetAllAsync()).FirstOrDefault(b => b.EsPrincipal);
                    if (principal is not null)
                        await UsuarioBodegaService.ReemplazarAsync(user.Id, new[] { principal.Id });
                }
            }

            var nombre = create.Nombre?.Trim();
            var apellido = create.Apellido?.Trim();
            var apellidoMaterno = create.ApellidoMaterno?.Trim();
            if (!string.IsNullOrWhiteSpace(nombre))
                await UserManager.AddClaimAsync(user, new Claim("given_name", nombre));
            if (!string.IsNullOrWhiteSpace(apellido))
                await UserManager.AddClaimAsync(user, new Claim("family_name", apellido));
            if (!string.IsNullOrWhiteSpace(apellidoMaterno))
                await UserManager.AddClaimAsync(user, new Claim("maternal_family_name", apellidoMaterno));

            success = "Usuario creado.";
            create.Email = string.Empty;
            create.Password = string.Empty;
            create.Nombre = string.Empty;
            create.Apellido = string.Empty;
            create.ApellidoMaterno = string.Empty;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    async Task AddRoleAsync(string userId)
    {
        await UpdateRoleAsync(userId, add: true);
    }

    async Task RemoveRoleAsync(string userId)
    {
        await UpdateRoleAsync(userId, add: false);
    }

    async Task UpdateRoleAsync(string userId, bool add)
    {
        using var loading = LoadingState.Begin();
        error = null;
        success = null;
        busy = true;

        try
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (user is null)
            {
                error = "Usuario no encontrado.";
                return;
            }

            if (!roleSelection.TryGetValue(userId, out var role) || string.IsNullOrWhiteSpace(role))
            {
                error = "Rol no seleccionado.";
                return;
            }

            var currentRoles = await UserManager.GetRolesAsync(user);

            if (add)
            {
                if (currentRoles.Contains(role))
                {
                    success = "El usuario ya tiene ese rol.";
                    return;
                }

                var res = await UserManager.AddToRoleAsync(user, role);
                if (!res.Succeeded)
                {
                    error = string.Join(" ", res.Errors.Select(e => e.Description));
                    return;
                }

                success = "Rol agregado.";
            }
            else
            {
                if (!currentRoles.Contains(role))
                {
                    success = "El usuario no tiene ese rol.";
                    return;
                }

                if (role == BodegaDESAM.Auth.AppRoles.Admin && currentRoles.Count(r => r == BodegaDESAM.Auth.AppRoles.Admin) == 1)
                {
                    var admins = new List<IdentityUser>();
                    foreach (var u in UserManager.Users.ToList())
                    {
                        if (await UserManager.IsInRoleAsync(u, BodegaDESAM.Auth.AppRoles.Admin))
                            admins.Add(u);
                    }

                    if (admins.Count <= 1 && await UserManager.IsInRoleAsync(user, BodegaDESAM.Auth.AppRoles.Admin))
                    {
                        error = "No se puede quitar el rol Admin al último administrador.";
                        return;
                    }
                }

                var res = await UserManager.RemoveFromRoleAsync(user, role);
                if (!res.Succeeded)
                {
                    error = string.Join(" ", res.Errors.Select(e => e.Description));
                    return;
                }

                success = "Rol quitado.";
            }

            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    static bool TieneAccesoActivo(IdentityUser user) =>
        !user.LockoutEnabled || !user.LockoutEnd.HasValue || user.LockoutEnd <= DateTimeOffset.UtcNow;

    async Task CambiarAccesoAsync(string userId, bool activar)
    {
        using var loading = LoadingState.Begin();
        error = null;
        success = null;
        busy = true;

        try
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (user is null)
            {
                error = "Usuario no encontrado.";
                return;
            }

            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var currentUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (!activar && user.Id == currentUserId)
            {
                error = "No puedes desactivar tu propio acceso.";
                return;
            }

            if (!activar && await EsUltimoAdministradorActivoAsync(user))
            {
                error = "No se puede desactivar al último administrador con acceso activo.";
                return;
            }

            user.LockoutEnabled = true;
            var res = await UserManager.SetLockoutEndDateAsync(user, activar ? null : DateTimeOffset.MaxValue);
            if (!res.Succeeded)
            {
                error = string.Join(" ", res.Errors.Select(e => e.Description));
                return;
            }

            if (activar)
                await UserManager.ResetAccessFailedCountAsync(user);

            var securityStamp = await UserManager.UpdateSecurityStampAsync(user);
            if (!securityStamp.Succeeded)
            {
                error = string.Join(" ", securityStamp.Errors.Select(e => e.Description));
                return;
            }

            success = activar ? "Acceso activado." : "Acceso desactivado.";
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    async Task<bool> EsUltimoAdministradorActivoAsync(IdentityUser candidato)
    {
        if (!await UserManager.IsInRoleAsync(candidato, BodegaDESAM.Auth.AppRoles.Admin))
            return false;

        var administradoresActivos = 0;
        foreach (var usuario in UserManager.Users.ToList())
        {
            if (TieneAccesoActivo(usuario) && await UserManager.IsInRoleAsync(usuario, BodegaDESAM.Auth.AppRoles.Admin))
                administradoresActivos++;
        }

        return administradoresActivos <= 1;
    }

}
