@page "/admin/establecimientos"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.Admin)]

@using BodegaDESAM.Services

@inject EstablecimientoService EstablecimientoService
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h3 class="page-title m-0">Establecimientos</h3>
        <p class="page-subtitle mb-0">Administra los destinos disponibles para las salidas.</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm" @onclick="Nuevo">Nuevo establecimiento</button>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (establecimientos is null)
{
    <p>Cargando...</p>
}
else if (establecimientos.Count == 0)
{
    <div class="card-section p-3">
        <p class="mb-0 text-muted">No hay establecimientos registrados.</p>
    </div>
}
else
{
    <div class="card-section p-2">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var establecimiento in establecimientos)
                    {
                        <tr>
                            <td>@establecimiento.Id</td>
                            <td>@establecimiento.Nombre</td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Editar(establecimiento.Id)">
                                    Editar
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm ms-1" @onclick="() => EliminarAsync(establecimiento.Id)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Establecimiento>? establecimientos;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private void Nuevo() => Nav.NavigateTo("/admin/establecimientos/nuevo");

    private void Editar(int id) => Nav.NavigateTo($"/admin/establecimientos/editar/{id}");

    private async Task CargarAsync()
    {
        using var loading = LoadingState.Begin();
        establecimientos = await EstablecimientoService.GetAllAsync();
    }

    private async Task EliminarAsync(int id)
    {
        error = null;
        using var loading = LoadingState.Begin();

        try
        {
            await EstablecimientoService.DeleteAsync(id);
            await CargarAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
