@page "/entradas/nuevo"
@page "/entradas/editar/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.AdminOrBodega)]

@using BodegaDESAM.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject EntradaService EntradaService
@inject ProveedorService ProveedorService
@inject BodegaService BodegaService
@inject ProductoService ProductoService
@inject MarcaService MarcaService
@inject ModeloService ModeloService
@inject ProductoSerieService ProductoSerieService
@inject LoteService LoteService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<div class="movement-form-header">
    <div>
        <span class="movement-form-eyebrow">Movimientos de inventario</span>
        <h3 class="page-title mb-0">@Titulo</h3>
    </div>
</div>

<EditForm Model="entrada" OnValidSubmit="Guardar" FormName="EditarEntrada" class="movement-form">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    @if (!string.IsNullOrWhiteSpace(ErrorGuardar))
    {
        <div class="alert alert-danger py-2" role="alert">@ErrorGuardar</div>
    }

    <section class="card-section movement-form-panel mb-3">
        <div class="movement-form-panel-header">
            <div class="movement-form-panel-icon"><i class="bi bi-box-arrow-in-down"></i></div>
            <div><h5>Información de la entrada</h5><p>Registra el origen y la fecha del movimiento.</p></div>
        </div>
        <div class="movement-form-panel-body">
        <div class="row g-3">
            <div class="col-12 col-md-3">
                <label class="form-label">Fecha</label>
                <InputDate class="form-control" @bind-Value="entrada.Fecha" />
                <ValidationMessage For="@(() => entrada.Fecha)" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label">Bodega</label>
                <div class="form-control-plaintext fw-semibold">
                    <i class="bi bi-building me-1"></i>
                    @(bodegas.FirstOrDefault(b => b.Id == entrada.id_bodega)?.Nombre ?? "Bodega Central")
                </div>
            </div>

            <div class="col-12 col-md-5">
                <label class="form-label">Proveedor</label>
                <InputSelect class="form-select" @bind-Value="entrada.id_proveedor">
                    <option value="0">-- Seleccionar Proveedor --</option>
                    @foreach (var proveedor in proveedores)
                    {
                        <option value="@proveedor.Id">@proveedor.Nombre</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => entrada.id_proveedor)" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label">N° Documento</label>
                <InputText class="form-control" @bind-Value="entrada.NDocumento" />
                <ValidationMessage For="@(() => entrada.NDocumento)" />
            </div>

            <div class="col-12 col-md-8">
                <label class="form-label">Observaciones</label>
                <InputText class="form-control" @bind-Value="entrada.Observacion" />
                <ValidationMessage For="@(() => entrada.Observacion)" />
            </div>
        </div>
        </div>
    </section>

    <div class="movement-form-section-header">
        <div><h5>Detalle de productos</h5><p>Agrega los productos recibidos en esta entrada.</p></div>
        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AgregarProducto" disabled="@DetalleBloqueado"><i class="bi bi-plus-lg me-1"></i>Agregar producto</button>
    </div>

    @if (DetalleBloqueado)
    {
        <div class="alert alert-warning py-2" role="alert">
            El detalle y la bodega no pueden modificarse porque esta entrada ya abastece una o más salidas.
        </div>
    }

    <div class="card-section movement-form-table mb-3">
        <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Lote (opcional)</th>
                <th>Cantidad</th>
                <th>Fecha Vencimiento</th>
                <th style="min-width: 260px">N° Serie (opcional)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detalle in entrada.DetalleEntrada)
            {
                <tr>
                    <td>
                        <InputSelect class="form-select" @bind-Value="detalle.id_producto" disabled="@DetalleBloqueado">
                            <option value="0">-- Seleccionar Producto --</option>
                            @foreach(var p in productos){
                                <option value="@p.Id">@p.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => detalle.id_producto)" />
                    </td>
                    <td>
                        <InputSelect class="form-select" @bind-Value="detalle.id_marca" @bind-Value:after="() => OnMarcaChanged(detalle)" disabled="@DetalleBloqueado">
                            <option value="0">-- Seleccionar Marca --</option>
                            @foreach(var m in marcas){
                                <option value="@m.Id">@m.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => detalle.id_marca)" />
                    </td>
                    <td>
                        <InputSelect class="form-select" @bind-Value="detalle.id_modelo" disabled="@(DetalleBloqueado || detalle.id_marca == 0)">
                            <option value="">-- Sin modelo --</option>
                            @foreach (var mo in GetModelosPorMarca(detalle.id_marca))
                            {
                                <option value="@mo.Id">@mo.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => detalle.id_modelo)" />
                    </td>
                    <td>
                        <input type="text" class="form-control" placeholder="Ej: L2024-001"
                               @bind="LoteInput[detalle]" @bind:event="oninput" maxlength="50" disabled="@DetalleBloqueado" />
                        @if (LoteInput.TryGetValue(detalle, out var lv) && lv?.Length > 50)
                        {
                            <div class="text-danger small mt-1">Máximo 50 caracteres.</div>
                        }
                    </td>
                    <td>
                        <InputNumber class="form-control" @bind-Value="detalle.Cantidad" disabled="@DetalleBloqueado" />
                        <ValidationMessage For="@(() => detalle.Cantidad)" />
                    </td>
                    <td>
                        <InputDate class="form-control" @bind-Value="detalle.FechaVencimiento" disabled="@DetalleBloqueado" />
                        <ValidationMessage For="@(() => detalle.FechaVencimiento)" />
                    </td>
                    <td>
                        <textarea class="form-control form-control-sm" rows="3" placeholder="1 serie por línea (dejar vacío si no aplica)"
                                  @bind="SerieInput[detalle]" @bind:event="oninput" disabled="@DetalleBloqueado"></textarea>
                        @if (ErroresSerie.TryGetValue(detalle, out var err) && !string.IsNullOrWhiteSpace(err))
                        {
                            <div class="text-danger small mt-1">@err</div>
                        }
                    </td>
                    <td>
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => EliminarProducto(detalle)" disabled="@DetalleBloqueado">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
        </table>
        </div>
    </div>

    <div class="movement-form-actions">
        <button type="submit" class="btn btn-primary" disabled="@Busy">
            @if (Busy)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                <span>Guardando...</span>
            }
            else
            {
                <span>Guardar</span>
            }
        </button>
        <button type="button" class="btn btn-secondary" @onclick="Volver" disabled="@Busy">Cancelar</button>
    </div>
</EditForm>

@code {
    [Parameter] 
    public int? Id { get; set; }

    [SupplyParameterFromForm]
    Entrada entrada { get; set; } = new() { Fecha = DateOnly.FromDateTime(DateTime.Now) };
    [SupplyParameterFromForm]
    List<Bodega> bodegas { get; set; } = new();
    [SupplyParameterFromForm]
    List<Proveedor> proveedores { get; set; } = new();
    [SupplyParameterFromForm]
    List<Producto> productos { get; set; } = new();
    [SupplyParameterFromForm]
    List<Marca> marcas { get; set; } = new();
    [SupplyParameterFromForm]
    List<Modelo> modelos { get; set; } = new();
    string Titulo { get; set; } = string.Empty;

    bool Busy;
    bool DetalleBloqueado;
    string? ErrorGuardar;

    Dictionary<DetalleEntrada, string> SerieInput { get; set; } = new();
    Dictionary<DetalleEntrada, string?> ErroresSerie { get; set; } = new();
    Dictionary<DetalleEntrada, string> LoteInput { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        bodegas = await BodegaService.GetAllAsync();
        proveedores = await ProveedorService.GetAllAsync();
        productos = await ProductoService.GetAllAsync();
        marcas = await MarcaService.GetAllAsync();
        modelos = await ModeloService.GetAllAsync();

        if (Id != null)
        {
            var existente = await EntradaService.GetByIdAsync(Id.Value);
            if (existente != null)
            {
                entrada = existente;
                Titulo += $"Editar Entrada > {Id.ToString()}-{entrada.Proveedor.Nombre}-{entrada.NDocumento}";
                DetalleBloqueado = await EntradaService.TieneSalidasRelacionadasAsync(Id.Value);
            }
            else
            {
                ErrorGuardar = "La entrada no existe o fue eliminada.";
            }
        }
        else
        {
            Titulo = "Nueva Entrada";

            // Asignar bodega principal por defecto
            var bodegaPrincipal = bodegas.FirstOrDefault(b => b.EsPrincipal);
            if (bodegaPrincipal != null)
            {
                entrada.id_bodega = bodegaPrincipal.Id;
            }
        }

        foreach (var d in entrada.DetalleEntrada)
        {
            SerieInput.TryAdd(d, string.Join(Environment.NewLine, d.ProductoSeries.OrderBy(s => s.Serie).Select(s => s.Serie)));
            LoteInput.TryAdd(d, d.Lote?.Codigo ?? string.Empty);
        }
    }

    private async Task Guardar()
    {
        ErrorGuardar = null;

        if (entrada.DetalleEntrada.Count == 0)
        {
            ErrorGuardar = "Debe agregar al menos un producto al detalle.";
            return;
        }

        if (!ValidarSeries())
            return;

        if (!ValidarLotes())
            return;

        Busy = true;
        try
        {
            if (Id == null)
            {
                var auth = await AuthStateProvider.GetAuthenticationStateAsync();
                var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
                await ResolverLotesAsync();
                await EntradaService.CreateAsync(entrada, userId ?? string.Empty);

                await GuardarSeriesAsync();
            }
            else
            {
                var existente = await EntradaService.GetByIdAsync(Id.Value);
                if (existente != null)
                {
                    if (!DetalleBloqueado)
                    {
                        await ResolverLotesAsync();
                    }

                    await EntradaService.UpdateAsync(entrada);

                    if (!DetalleBloqueado)
                        await GuardarSeriesAsync();
                }
                else
                {
                    ErrorGuardar = "La entrada no existe o fue eliminada.";
                }
            }

            Nav.NavigateTo("/entradas");
        }
        catch (Exception ex)
        {
            ErrorGuardar = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }
    void AgregarProducto()
    {
        var d = new DetalleEntrada();
        entrada.DetalleEntrada.Add(d);
        SerieInput[d] = string.Empty;
        LoteInput[d] = string.Empty;
    }

    void EliminarProducto(DetalleEntrada detalle)
    {
        entrada.DetalleEntrada.Remove(detalle);
        SerieInput.Remove(detalle);
        ErroresSerie.Remove(detalle);
        LoteInput.Remove(detalle);
    }

    void Volver() => Nav.NavigateTo("/entradas");

    bool ValidarSeries()
    {
        ErroresSerie.Clear();
        var ok = true;

        foreach (var d in entrada.DetalleEntrada)
        {
            SerieInput.TryGetValue(d, out var raw);
            raw ??= string.Empty;

            var series = raw
                .Split(new[] { "\r\n", "\n", "\r" }, StringSplitOptions.None)
                .Select(s => s.Trim())
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .ToList();

            if (series.Count == 0)
                continue; // opcional: no se detallan series

            if (d.Cantidad <= 0)
            {
                ErroresSerie[d] = "Ingresa la cantidad antes de detallar series.";
                ok = false;
                continue;
            }

            if (series.Count != d.Cantidad)
            {
                ErroresSerie[d] = $"Debes ingresar {d.Cantidad} series (una por unidad) o ninguna.";
                ok = false;
                continue;
            }

            var dup = series
                .GroupBy(s => s, StringComparer.OrdinalIgnoreCase)
                .FirstOrDefault(g => g.Count() > 1);

            if (dup != null)
            {
                ErroresSerie[d] = $"Serie duplicada en el detalle: {dup.Key}";
                ok = false;
            }
        }

        return ok;
    }

    bool ValidarLotes()
    {
        foreach (var d in entrada.DetalleEntrada)
        {
            LoteInput.TryGetValue(d, out var codigo);
            if (string.IsNullOrWhiteSpace(codigo))
                continue;

            if (codigo.Trim().Length > 50)
            {
                ErrorGuardar = "El código de lote no puede superar los 50 caracteres.";
                return false;
            }

            if (d.id_producto <= 0)
            {
                ErrorGuardar = "Debe seleccionar un producto antes de asignar un lote.";
                return false;
            }
        }
        return true;
    }

    async Task ResolverLotesAsync()
    {
        foreach (var d in entrada.DetalleEntrada)
        {
            LoteInput.TryGetValue(d, out var codigo);
            if (string.IsNullOrWhiteSpace(codigo))
            {
                d.id_lote = null;
                continue;
            }

            var lote = await LoteService.GetOrCreateAsync(d.id_producto, codigo.Trim());
            d.id_lote = lote.Id;
        }
    }

    async Task GuardarSeriesAsync()
    {
        foreach (var d in entrada.DetalleEntrada)
        {
            SerieInput.TryGetValue(d, out var raw);
            var series = (raw ?? string.Empty)
                .Split(new[] { "\r\n", "\n", "\r" }, StringSplitOptions.None)
                .Select(s => s.Trim())
                .Where(s => !string.IsNullOrWhiteSpace(s));

            await ProductoSerieService.SincronizarSeriesEntradaAsync(d.id_producto, d.Id, series);
        }
    }

    /// <summary>
    /// Filtra modelos por la marca seleccionada
    /// </summary>
    IEnumerable<Modelo> GetModelosPorMarca(long idMarca)
    {
        if (idMarca == 0)
            return Enumerable.Empty<Modelo>();

        return modelos.Where(m => m.id_marca == idMarca);
    }

    /// <summary>
    /// Limpia el modelo seleccionado cuando cambia la marca
    /// </summary>
    void OnMarcaChanged(DetalleEntrada detalle)
    {
        // Si la marca cambia, limpiar el modelo seleccionado
        var modeloActual = modelos.FirstOrDefault(m => m.Id == detalle.id_modelo);
        if (modeloActual != null && modeloActual.id_marca != detalle.id_marca)
        {
            detalle.id_modelo = null;
        }
    }

}
