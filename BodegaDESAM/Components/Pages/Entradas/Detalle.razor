@page "/entradas/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.Public)]

@using BodegaDESAM.Services
@inject EntradaService EntradaService
@inject UserDisplayNameService UserDisplayNameService
@inject NavigationManager Nav
@inject BodegaContextService BodegaContext

@if (entrada == null) { <p>Cargando...</p> }
else
{
    <div class="detail-header">
        <div class="d-flex align-items-center gap-2"><button class="btn btn-outline-secondary btn-sm" @onclick="Volver"><i class="bi bi-arrow-left"></i><span class="visually-hidden">Volver</span></button><div><span class="movement-kind">Entrada</span><h3 class="page-title m-0">Detalle #@entrada.Id</h3></div></div>
        <div class="detail-header-actions"><a class="btn btn-outline-info" target="_blank" href="@($"/reports/entradas/{entrada.Id}.pdf")"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a><AuthorizeView Roles="@BodegaDESAM.Auth.AppRoles.AdminOrBodega"><Authorized><button class="btn btn-primary" @onclick="Editar"><i class="bi bi-pencil me-1"></i>Editar</button></Authorized></AuthorizeView></div>
    </div>
    <section class="card-section detail-summary"><h5>Información general</h5><dl class="detail-grid"><div><dt>Fecha</dt><dd>@entrada.Fecha.ToString("dd/MM/yyyy")</dd></div><div><dt>Bodega</dt><dd>@entrada.Bodega.Nombre @if (entrada.Bodega.EsPrincipal) { <span class="badge bg-primary ms-1">Principal</span> }</dd></div><div><dt>Proveedor</dt><dd>@entrada.Proveedor.Nombre</dd></div><div><dt>N.º documento</dt><dd>@entrada.NDocumento</dd></div><div><dt>Registrado por</dt><dd>@(usuario ?? "Usuario no disponible")</dd></div></dl>@if (!string.IsNullOrWhiteSpace(entrada.Observacion)) { <div class="detail-observation"><span>Observación</span><p>@entrada.Observacion</p></div> }</section>
    <section class="card-section detail-items"><div class="detail-section-heading"><div><h5 class="mb-0">Productos recibidos</h5><span class="text-muted small">@entrada.DetalleEntrada.Count ítem(s)</span></div></div>
        <div class="table-responsive d-none d-md-block"><table class="table table-hover align-middle mb-0"><thead><tr><th>Producto</th><th>Marca / modelo</th><th>Lote</th><th>Series</th><th>Vencimiento</th><th class="text-end">Cantidad</th><th class="text-end">Valor unitario (CLP)</th></tr></thead><tbody>@foreach (var d in entrada.DetalleEntrada) { <tr><td><div class="fw-semibold">@d.Producto.Nombre</div><div class="small text-muted">@d.Producto.CategoriaProducto?.Nombre</div></td><td><div>@d.Marca?.Nombre</div>@if (d.Modelo != null) { <div class="small text-muted">@d.Modelo.Nombre</div> }</td><td>@(d.Lote?.Codigo ?? "—")</td><td class="series-cell">@(d.ProductoSeries?.Count > 0 ? string.Join(", ", d.ProductoSeries.Select(s => s.Serie)) : "Sin serie")</td><td class="text-nowrap">@(d.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</td><td class="text-end fw-semibold">@d.Cantidad</td><td class="text-end text-nowrap">@(d.ValorUnitario.HasValue ? $"$ {d.ValorUnitario.Value:N0}" : "Sin valor")</td></tr> }</tbody></table></div>
        <div class="detail-item-cards d-md-none">@foreach (var d in entrada.DetalleEntrada) { <article class="detail-item-card"><div class="d-flex justify-content-between gap-3"><div><div class="fw-semibold">@d.Producto.Nombre</div><div class="small text-muted">@d.Producto.CategoriaProducto?.Nombre</div></div><div class="text-end"><span class="detail-quantity">@d.Cantidad</span><div class="small text-muted">unidades</div></div></div><dl><div><dt>Marca / modelo</dt><dd>@d.Marca?.Nombre @(d.Modelo != null ? $"· {d.Modelo.Nombre}" : "")</dd></div><div><dt>Lote</dt><dd>@(d.Lote?.Codigo ?? "—")</dd></div><div><dt>Vencimiento</dt><dd>@(d.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</dd></div><div><dt>Valor unitario</dt><dd>@(d.ValorUnitario.HasValue ? $"$ {d.ValorUnitario.Value:N0}" : "Sin valor")</dd></div><div class="full"><dt>Series</dt><dd>@(d.ProductoSeries?.Count > 0 ? string.Join(", ", d.ProductoSeries.Select(s => s.Serie)) : "Sin serie")</dd></div></dl></article> }</div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }
    private Entrada? entrada; private string? usuario;
    protected override async Task OnInitializedAsync() { using var loading = LoadingState.Begin(); entrada = await EntradaService.GetByIdAsync(Id, await BodegaContext.GetBodegaActivaAsync()); if (entrada == null) { Nav.NavigateTo("/entradas"); return; } usuario = await UserDisplayNameService.GetNombreAsync(entrada.IdUsuario); }
    private void Volver() => Nav.NavigateTo("/entradas"); private void Editar() => Nav.NavigateTo($"/entradas/editar/{Id}");
}
