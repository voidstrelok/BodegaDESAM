@page "/proveedores/nuevo"
@page "/proveedores/editar/{Id:int}"
@rendermode InteractiveServer

@using BodegaDESAM.Services

@inject ProveedorService ProveedorService
@inject NavigationManager Nav

<h3 class="page-title mb-3">@Titulo</h3>

<EditForm Model="proveedor" OnValidSubmit="Guardar" FormName="EditarProveedor">
    <DataAnnotationsValidator />

    <div class="card-section p-3 mb-3">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label">Nombre</label>
                <InputText class="form-control" @bind-Value="proveedor.Nombre" />
                <ValidationMessage For="@(() => proveedor.Nombre)" />
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="button" class="btn btn-secondary" @onclick="Volver">Cancelar</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    [SupplyParameterFromForm]
    private Proveedor proveedor { get; set; } = new();

    private string Titulo { get; set; } = "Nuevo Proveedor";

    protected override async Task OnInitializedAsync()
    {
        if (Id != null)
        {
            var existente = await ProveedorService.GetByIdAsync(Id.Value);
            if (existente != null)
            {
                proveedor = existente;
                Titulo = $"Editar Proveedor > {proveedor.Id}";
            }
        }
    }

    private async Task Guardar()
    {
        if (Id == null)
            await ProveedorService.CreateAsync(proveedor);
        else
            await ProveedorService.UpdateAsync(proveedor);

        Nav.NavigateTo("/proveedores");
    }

    private void Volver() => Nav.NavigateTo("/proveedores");
}
