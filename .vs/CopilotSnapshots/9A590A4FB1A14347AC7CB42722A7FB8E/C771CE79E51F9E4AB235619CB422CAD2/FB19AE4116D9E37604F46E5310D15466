@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer
@layout BodegaDESAM.Components.Layout.AuthLayout

@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav

<PageTitle>Login</PageTitle>

<div class="card-section p-3">
    <EditForm Model="model" OnValidSubmit="OnSubmitAsync">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <div class="mb-3">
            <label class="form-label">Usuario</label>
            <InputText class="form-control" @bind-Value="model.Email" />
            <ValidationMessage For="() => model.Email" />
        </div>

        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <InputText type="password" class="form-control" @bind-Value="model.Password" />
            <ValidationMessage For="() => model.Password" />
        </div>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="model.RememberMe" />
            <label class="form-check-label">Recordarme</label>
        </div>

        <button class="btn btn-primary w-100" disabled="@busy" type="submit">Entrar</button>
    </EditForm>
</div>

@code {
    readonly LoginModel model = new();
    string? error;
    bool busy;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("error", out var value)
            && value == "1")
        {
            error = "Credenciales inválidas.";
        }
    }

    async Task OnSubmitAsync()
    {
        error = null;
        busy = true;

        try
        {
            var url = $"/auth/login?email={Uri.EscapeDataString(model.Email)}&password={Uri.EscapeDataString(model.Password)}&rememberMe={model.RememberMe.ToString().ToLowerInvariant()}";
            Nav.NavigateTo(url, forceLoad: true);
        }
        finally
        {
            busy = false;
        }
    }

    sealed class LoginModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
