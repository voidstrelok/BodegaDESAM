@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthState

<AuthorizeView>
    <Authorized>
        <div class="text-muted small">
            User: @context.User.Identity?.Name
            <br />
            Roles: @string.Join(", ", context.User.Claims.Where(c => c.Type.EndsWith("/role") || c.Type == "role").Select(c => c.Value))
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="text-muted small">Not authorized</div>
    </NotAuthorized>
</AuthorizeView>
