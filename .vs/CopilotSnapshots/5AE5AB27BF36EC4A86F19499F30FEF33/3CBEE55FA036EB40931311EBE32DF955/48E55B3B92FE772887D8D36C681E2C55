@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />

        <AuthorizeView>
            <Authorized Context="auth">
                <div class="px-3 pb-3 text-light small text-truncate" style="max-width: 100%;">
                    Sesión: @(auth.User.FindFirst("given_name")?.Value ?? auth.User.Identity?.Name)
                </div>
            </Authorized>
        </AuthorizeView>
    </div>

    <main>
        <article class="content px-4 py-3">
            <div class="container-fluid">
                @Body
            </div>
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
