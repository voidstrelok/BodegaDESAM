@page "/entradas"
@rendermode InteractiveServer

@using BodegaDESAM.Services
@inject EntradaService EntradaService
@inject NavigationManager Nav

<h3>Entradas</h3>

<button type="button" @onclick="Nuevo">Nuevo</button>

@if (entradas == null)
{
    <p>Cargando...</p>
}
else if (entradas.Count == 0)
{
    <p>No hay entradas ingresadas.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Código</th>
                <th>Fecha</th>
                <th>Proveedor</th>
                <th>N° Documento</th>
                <th>Observación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in entradas)
            {
                <tr>
                    <td>@e.Id</td>
                    <td>@e.Fecha</td>
                    <td>@e.Proveedor.Nombre</td>
                    <td>@e.NDocumento</td>
                    <td>@e.Observacion</td>
                    <td>
                        <button 
                                @onclick="() => VerEntrada(e.Id)">
                            Ver
                        </button>

                        <button @onclick='() => Nav.NavigateTo($"/entradas/editar/{e.Id}")'>Editar</button>
          
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => Eliminar(e.Id)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (MostrarModal && EntradaSeleccionada != null)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            Entrada Nº @EntradaSeleccionada.Id
                        </h5>
                        <button class="btn-close"
                                @onclick="CerrarModal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="container-fluid">

                            <!-- Datos generales -->
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <strong>N° Salida</strong>
                                    <div>@EntradaSeleccionada.Id</div>
                                </div>

                                <div class="col-md-4">
                                    <strong>Fecha</strong>
                                    <div>@EntradaSeleccionada.Fecha.ToString("dd/MM/yyyy")</div>
                                </div>

                                <div class="col-md-4">
                                    <strong>Usuario</strong>
                                    <div>TODO</div>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong>Proveedor</strong>
                                    <div>@EntradaSeleccionada.Proveedor.Nombre</div>
                                </div>
                            </div>

                            <hr />

                            <!-- Detalle de productos -->
                            <h6 class="mb-2">Detalle de productos</h6>

                            <table class="table table-sm table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-center">Cantidad</th>
                                        <th>Caducidad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in EntradaSeleccionada.DetalleEntrada)
                                    {
                                        <tr>
                                            <td>@d.Producto.Nombre</td>
                                            <td class="text-center">@d.Cantidad</td>
                                            <td>@d.FechaVencimiento.ToString()</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <!-- Observaciones generales -->
                            @if (true)
                            {
                                <div class="mt-3">
                                    <strong>Observaciones</strong>
                                    <div class="border rounded p-2 bg-light">
                                        @EntradaSeleccionada.Observacion
                                    </div>
                                </div>
                            }

                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary"
                                @onclick="CerrarModal">
                            Cerrar
                        </button>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
}

@code {
    List<Entrada>? entradas;
    bool MostrarModal;
    Entrada? EntradaSeleccionada;

    protected override async Task OnInitializedAsync()
    {
        entradas = await EntradaService.GetAllAsync();
    }

    void Nuevo()
    {
        Nav.NavigateTo("/entradas/nuevo");
    }
    void Editar(long id) => Nav.NavigateTo($"/entradas/editar/{id}");
    async void Eliminar(int id)
    {
        return;
    }

    async Task VerEntrada(long Id)
    {
        EntradaSeleccionada = await EntradaService.GetByIdAsync(Id);
        MostrarModal = true;
    }

    void CerrarModal()
    {
        MostrarModal = false;
    }
}