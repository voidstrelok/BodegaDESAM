@page "/productos"
@rendermode InteractiveServer

@using BodegaDESAM.Services
@inject ProductoService Service
@inject NavigationManager Nav

<h3>Productos</h3>

<button type="button" @onclick="Nuevo">Nuevo</button>

@if (productos == null)
{
    <p>Cargando...</p>
}
else if(productos.Count == 0)
{
    <p>No hay productos ingresados.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Serie</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in productos)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Nombre</td>
                    <td>@p.Marca.Nombre</td>
                    <td>@p.Modelo</td>
                    <td>@p.NSerie</td>
                    <td>TODO</td>
                    <td>
                        <button @onclick='() => Nav.NavigateTo($"/productos/editar/{p.Id}")'>Editar</button>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => Eliminar(p.Id)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<Producto>? productos;

    protected override async Task OnInitializedAsync()
    {
        productos = await Service.GetAllAsync();
    }

    void Nuevo()
    {
        Nav.NavigateTo("/productos/nuevo");
    }
    void Editar(int id) => Nav.NavigateTo($"/productos/editar/{id}");
    async void Eliminar(int id)
    {
        return;
    }
}