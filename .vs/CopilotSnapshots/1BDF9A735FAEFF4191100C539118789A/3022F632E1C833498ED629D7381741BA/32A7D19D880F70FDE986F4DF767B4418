@page "/salidas"
@rendermode InteractiveServer

@using BodegaDESAM.Services
@inject SalidaService SalidaService
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <h3 class="page-title m-0">Salidas</h3>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary btn-sm" @onclick="Nuevo">Nuevo</button>
    </div>
</div>

@if (salidas == null)
{
    <p>Cargando...</p>
}
else if (salidas.Count == 0)
{
    <p>No hay salidas ingresadas.</p>
}
else
{
    <div class="card-section p-2">
        <table class="table table-sm table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Código</th>
                <th>Fecha</th>
                <th>Establecimiento</th>
                <th>Observación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in salidas)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@s.Fecha</td>
                    <td>@s.EStablecimiento.Nombre</td>
                    <td>@s.Observacion</td>
                    <td class="text-nowrap">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => VerSalida(s.Id)">Ver</button>
                        <button class="btn btn-outline-primary btn-sm ms-1" @onclick='() => Nav.NavigateTo($"/salidas/editar/{s.Id}")'>Editar</button>
                    </td>
                </tr>
            }
        </tbody>
        </table>
    </div>

    @if (MostrarModal && SalidaSeleccionada != null)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            Salida Nº @SalidaSeleccionada.Id
                        </h5>
                        <button class="btn-close" @onclick="CerrarModal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="container-fluid">
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <strong>N° Salida</strong>
                                    <div>@SalidaSeleccionada.Id</div>
                                </div>

                                <div class="col-md-4">
                                    <strong>Fecha</strong>
                                    <div>@SalidaSeleccionada.Fecha.ToString("dd/MM/yyyy")</div>
                                </div>

                                <div class="col-md-4">
                                    <strong>Establecimiento</strong>
                                    <div>@SalidaSeleccionada.EStablecimiento.Nombre</div>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong>Solicitante</strong>
                                    <div>@SalidaSeleccionada.Solicitante</div>
                                </div>
                            </div>

                            <hr />

                            <h6 class="mb-2">Detalle de productos</h6>
                            <table class="table table-sm table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-center">Cantidad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in SalidaSeleccionada.DetalleSalida)
                                    {
                                        <tr>
                                            <td>@d.Producto.Nombre</td>
                                            <td class="text-center">@d.Cantidad</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="mt-3">
                                <strong>Observaciones</strong>
                                <div class="border rounded p-2 bg-light">
                                    @SalidaSeleccionada.Observacion
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CerrarModal">Cerrar</button>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
}

@code {
    private List<Salida>? salidas;
    private bool MostrarModal;
    private Salida? SalidaSeleccionada;

    protected override async Task OnInitializedAsync()
    {
        salidas = await SalidaService.GetAllAsync();
    }

    private void Nuevo() => Nav.NavigateTo("/salidas/nuevo");

    private async Task VerSalida(int id)
    {
        SalidaSeleccionada = await SalidaService.GetByIdAsync(id);
        MostrarModal = true;
    }

    private void CerrarModal()
    {
        MostrarModal = false;
        SalidaSeleccionada = null;
    }
}
