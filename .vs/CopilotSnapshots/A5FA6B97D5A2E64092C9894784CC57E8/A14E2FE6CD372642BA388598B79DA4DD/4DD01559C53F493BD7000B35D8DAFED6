    [Fact]
    public async Task GetInventarioActualAsync_MultipleSkus_ReturnsSeparateRows()
    {
        var options = NewDb();

        await using (var db = new PostgresDataContext(options))
        {
            db.Marca.Add(new Marca { Id = 1, Nombre = "Marca 1" });
            db.Marca.Add(new Marca { Id = 2, Nombre = "Marca 2" });
            db.Producto.Add(new Producto { Id = 1, Nombre = "Prod A" });
            db.DetalleEntrada.Add(new DetalleEntrada { id_producto = 1, id_marca = 1, Cantidad = 5, FechaVencimiento = DateOnly.FromDateTime(DateTime.UtcNow) });
            db.DetalleEntrada.Add(new DetalleEntrada { id_producto = 1, id_marca = 2, Cantidad = 8, FechaVencimiento = DateOnly.FromDateTime(DateTime.UtcNow) });
            await db.SaveChangesAsync();
        }

        var service = new InventarioService(new TestDbContextFactory(options));
        var result = await service.GetInventarioActualAsync();

        Assert.Equal(2, result.Count);
        Assert.Contains(result, r => r.IdMarca == 1 && r.StockActual == 5);
        Assert.Contains(result, r => r.IdMarca == 2 && r.StockActual == 8);
    }

