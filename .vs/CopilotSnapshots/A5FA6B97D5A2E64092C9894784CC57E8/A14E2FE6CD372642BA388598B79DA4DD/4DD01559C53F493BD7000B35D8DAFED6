    [Fact]
    public async Task GetSkusDisponiblesAsync_WithStock_ReturnsSku()
    {
        var options = NewDb();

        await using (var db = new PostgresDataContext(options))
        {
            db.Bodega.Add(new Bodega { Id = 1, Nombre = "Central", Codigo = "C1", EsPrincipal = true });
            db.Marca.Add(new Marca { Id = 1, Nombre = "Marca A" });
            db.Producto.Add(new Producto { Id = 1, Nombre = "Prod A" });
            db.Entrada.Add(new Entrada
            {
                Id = 1, IdUsuario = "usr", id_bodega = 1, id_proveedor = 0,
                Fecha = DateOnly.FromDateTime(DateTime.UtcNow), NDocumento = "D1",
                DetalleEntrada = new List<DetalleEntrada>
