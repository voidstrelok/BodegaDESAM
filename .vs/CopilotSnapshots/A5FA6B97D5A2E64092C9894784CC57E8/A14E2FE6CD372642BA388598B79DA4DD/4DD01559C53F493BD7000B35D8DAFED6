using BodegaDESAM.Services;
using Microsoft.EntityFrameworkCore;

namespace BodegaDESAM.Tests.Services;

public class InventarioServiceTests
{
    sealed class TestDbContextFactory : IDbContextFactory<PostgresDataContext>
    {
        private readonly DbContextOptions<PostgresDataContext> _options;

        public TestDbContextFactory(DbContextOptions<PostgresDataContext> options)
        {
            _options = options;
        }

        public PostgresDataContext CreateDbContext() => new(_options);
    }

    static DbContextOptions<PostgresDataContext> NewDb() =>
        new DbContextOptionsBuilder<PostgresDataContext>()
            .UseInMemoryDatabase($"inv_{Guid.NewGuid():N}")
            .Options;

    // ─── GetInventarioActualAsync ─────────────────────────────────────────────

    [Fact]
    public async Task GetInventarioActualAsync_WhenNoData_ReturnsEmptyList()
    {
        var options = NewDb();

        await using (var db = new PostgresDataContext(options))
        {
            db.Producto.Add(new Producto { Id = 1, Nombre = "Prod A" });
            await db.SaveChangesAsync();
        }

        var service = new InventarioService(new TestDbContextFactory(options));
        var result = await service.GetInventarioActualAsync();

        // No hay entradas, por lo tanto el inventario estará vacío
        Assert.Empty(result);
    }

    [Fact]
    public async Task GetInventarioActualAsync_WithEntriesAndExits_ComputesStock()
    {
        var options = NewDb();

        await using (var db = new PostgresDataContext(options))
        {
            db.Marca.Add(new Marca { Id = 10, Nombre = "Marca X" });
            db.Producto.Add(new Producto { Id = 1, Nombre = "Prod A" });
            db.DetalleEntrada.Add(new DetalleEntrada { id_producto = 1, id_marca = 10, Cantidad = 5, FechaVencimiento = DateOnly.FromDateTime(DateTime.UtcNow) });
            db.DetalleEntrada.Add(new DetalleEntrada { id_producto = 1, id_marca = 10, Cantidad = 2, FechaVencimiento = DateOnly.FromDateTime(DateTime.UtcNow) });
            db.DetalleSalida.Add(new DetalleSalida { id_producto = 1, id_marca = 10, Cantidad = 3 });
            await db.SaveChangesAsync();
        }

        var service = new InventarioService(new TestDbContextFactory(options));
        var result = await service.GetInventarioActualAsync();

        var item = Assert.Single(result);
        Assert.Equal(1, item.IdProducto);
        Assert.Equal(10, item.IdMarca);
        Assert.Equal("Prod A", item.NombreProducto);
        Assert.Equal("Marca X", item.Marca);
        Assert.Equal(7, item.TotalEntradas);
        Assert.Equal(3, item.TotalSalidas);
        Assert.Equal(4, item.StockActual);
    }

    [Fact]
    public async Task GetInventarioActualAsync_WithAumentoAjuste_IncreasesStock()
    {
        var options = NewDb();

        await using (var db = new PostgresDataContext(options))
        {
            db.Marca.Add(new Marca { Id = 1, Nombre = "Marca A" });
            db.Producto.Add(new Producto { Id = 1, Nombre = "Prod A" });
            db.DetalleEntrada.Add(new DetalleEntrada { id_producto = 1, id_marca = 1, Cantidad = 10, FechaVencimiento = DateOnly.FromDateTime(DateTime.UtcNow) });
            db.DetalleAjuste.Add(new DetalleAjuste { id_producto = 1, id_marca = 1, TipoAjuste = TipoAjuste.Aumento, Cantidad = 5 });
            await db.SaveChangesAsync();
        }

        var service = new InventarioService(new TestDbContextFactory(options));
        var result = await service.GetInventarioActualAsync();

        var item = Assert.Single(result);
        Assert.Equal(10, item.TotalEntradas);
        Assert.Equal(0, item.TotalSalidas);
        Assert.Equal(5, item.NetoAjustes);
        Assert.Equal(15, item.StockActual);
    }

    [Fact]
    public async Task GetInventarioActualAsync_WithDisminucionAjuste_DecreasesStock()
    {
        var options = NewDb();

        await using (var db = new PostgresDataContext(options))
        {
            db.Marca.Add(new Marca { Id = 1, Nombre = "Marca A" });
            db.Producto.Add(new Producto { Id = 1, Nombre = "Prod A" });
            db.DetalleEntrada.Add(new DetalleEntrada { id_producto = 1, id_marca = 1, Cantidad = 10, FechaVencimiento = DateOnly.FromDateTime(DateTime.UtcNow) });
            db.DetalleAjuste.Add(new DetalleAjuste { id_producto = 1, id_marca = 1, TipoAjuste = TipoAjuste.Disminucion, Cantidad = 3 });
            await db.SaveChangesAsync();
        }

        var service = new InventarioService(new TestDbContextFactory(options));
        var result = await service.GetInventarioActualAsync();

        var item = Assert.Single(result);
        Assert.Equal(-3, item.NetoAjustes);
        Assert.Equal(7, item.StockActual);
    }

    [Fact]
    public async Task GetInventarioActualAsync_WithModelo_PopulatesModeloAndCategoria()
    {
        var options = NewDb();

        await using (var db = new PostgresDataContext(options))
        {
            db.CategoriaProducto.Add(new CategoriaProducto { Id = 5, Nombre = "Categoría X" });
            db.Marca.Add(new Marca { Id = 2, Nombre = "Marca B" });
            db.Modelo.Add(new Modelo { Id = 7, Nombre = "Modelo Z" });
            db.Producto.Add(new Producto { Id = 3, Nombre = "Prod C", id_categoria_producto = 5 });
            db.DetalleEntrada.Add(new DetalleEntrada { id_producto = 3, id_marca = 2, id_modelo = 7, Cantidad = 4, FechaVencimiento = DateOnly.FromDateTime(DateTime.UtcNow) });
            await db.SaveChangesAsync();
