@page "/entradas"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.AdminOrBodega)]

@using BodegaDESAM.Services
@inject EntradaService EntradaService
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <h3 class="page-title m-0">Entradas</h3>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary btn-sm" @onclick="Nuevo">Nuevo</button>
    </div>
</div>

@if (entradas == null)
{
    <p>Cargando...</p>
}
else if (entradas.Count == 0)
{
    <p>No hay entradas ingresadas.</p>
}
else
{
    <div class="card-section p-2">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0" style="table-layout: fixed; width: 100%;">
        <thead>
            <tr>
                <th style="width: 90px; white-space: normal;">Código</th>
                <th style="width: 140px; white-space: normal;">Fecha</th>
                <th>Proveedor</th>
                <th style="width: 140px; white-space: normal;">N° Documento</th>
                <th style="width: 35%; white-space: normal;">Observación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in entradas)
            {
                <tr>
                    <td>@e.Id</td>
                    <td class="text-nowrap">@e.Fecha</td>
                    <td class="d-none d-md-table-cell">
                        <div class="text-truncate" title="@e.Proveedor.Nombre">@e.Proveedor.Nombre</div>
                    </td>
                    <td>@e.NDocumento</td>
                    <td class="d-none d-lg-table-cell">
                        <div class="text-truncate" title="@e.Observacion">@e.Observacion</div>
                    </td>
                    <td class="text-nowrap">
                        <button class="btn btn-outline-secondary btn-sm" title="Ver" @onclick="() => VerEntrada(e.Id)">
                            <span class="d-none d-sm-inline">Ver</span>
                            <span class="d-inline d-sm-none">🔍</span>
                        </button>
                        <button class="btn btn-outline-primary btn-sm ms-1" title="Editar" @onclick='() => Nav.NavigateTo($"/entradas/editar/{e.Id}")'>
                            <span class="d-none d-sm-inline">Editar</span>
                            <span class="d-inline d-sm-none">✏️</span>
                        </button>
                        <button class="btn btn-danger btn-sm ms-1" title="Eliminar" @onclick="() => Eliminar(e.Id)">
                            <span class="d-none d-sm-inline">Eliminar</span>
                            <span class="d-inline d-sm-none">🗑️</span>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
            </table>
        </div>
    </div>

    @if (MostrarModal && EntradaSeleccionada != null)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            Entrada Nº @EntradaSeleccionada.Id
                        </h5>
                        <button class="btn-close"
                                @onclick="CerrarModal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="container-fluid">

                            <!-- Datos generales -->
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <strong>N° Salida</strong>
                                    <div>@EntradaSeleccionada.Id</div>
                                </div>

                                <div class="col-md-4">
                                    <strong>Fecha</strong>
                                    <div>@EntradaSeleccionada.Fecha.ToString("dd/MM/yyyy")</div>
                                </div>

                                <div class="col-md-4">
                                    <strong>Usuario</strong>
                                    <div>TODO</div>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong>Proveedor</strong>
                                    <div>@EntradaSeleccionada.Proveedor.Nombre</div>
                                </div>
                            </div>

                            <hr />

                            <!-- Detalle de productos -->
                            <h6 class="mb-2">Detalle de productos</h6>

                            <table class="table table-sm table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-center">Cantidad</th>
                                        <th>Caducidad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in EntradaSeleccionada.DetalleEntrada)
                                    {
                                        <tr>
                                            <td>@d.Producto.Nombre</td>
                                            <td class="text-center">@d.Cantidad</td>
                                            <td>@d.FechaVencimiento.ToString()</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <!-- Observaciones generales -->
                            @if (true)
                            {
                                <div class="mt-3">
                                    <strong>Observaciones</strong>
                                    <div class="border rounded p-2 bg-light">
                                        @EntradaSeleccionada.Observacion
                                    </div>
                                </div>
                            }

                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary"
                                @onclick="CerrarModal">
                            Cerrar
                        </button>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @if (MostrarConfirmEliminar)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirmar eliminación</h5>
                        <button class="btn-close" @onclick="CancelarEliminar"></button>
                    </div>
                    <div class="modal-body">
                        ¿Eliminar la entrada #@IdEliminar?
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                        <button class="btn btn-danger" @onclick="ConfirmarEliminar">Eliminar</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
}

@code {
    List<Entrada>? entradas;
    bool MostrarModal;
    Entrada? EntradaSeleccionada;
    bool MostrarConfirmEliminar;
    long IdEliminar;

    protected override async Task OnInitializedAsync()
    {
        entradas = await EntradaService.GetAllAsync();
    }

    void Nuevo()
    {
        Nav.NavigateTo("/entradas/nuevo");
    }
    void Editar(long id) => Nav.NavigateTo($"/entradas/editar/{id}");
    Task Eliminar(long id)
    {
        IdEliminar = id;
        MostrarConfirmEliminar = true;
        return Task.CompletedTask;
    }

    async Task ConfirmarEliminar()
    {
        var id = IdEliminar;
        MostrarConfirmEliminar = false;

        var eliminado = await EntradaService.DeleteAsync(id);
        if (!eliminado)
            return;

        if (EntradaSeleccionada?.Id == id)
        {
            MostrarModal = false;
            EntradaSeleccionada = null;
        }

        entradas = await EntradaService.GetAllAsync();
    }

    void CancelarEliminar()
    {
        MostrarConfirmEliminar = false;
        IdEliminar = 0;
    }

    async Task VerEntrada(long Id)
    {
        EntradaSeleccionada = await EntradaService.GetByIdAsync(Id);
        MostrarModal = true;
    }

    void CerrarModal()
    {
        MostrarModal = false;
    }
}