@page "/salidas"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.AdminOrBodega)]

@using BodegaDESAM.Services
@inject SalidaService SalidaService
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <h3 class="page-title m-0">Salidas</h3>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary btn-sm" @onclick="Nuevo">Nuevo</button>
    </div>
</div>

@if (salidas == null)
{
    <p>Cargando...</p>
}
else if (salidas.Count == 0)
{
    <p>No hay salidas ingresadas.</p>
}
else
{
    <!-- Desktop / tablet (md+) -->
    <div class="card-section p-2 d-none d-md-block">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 90px">Código</th>
                        <th style="width: 140px">Fecha</th>
                        <th>Establecimiento</th>
                        <th style="width: 35%">Observación</th>
                        <th style="width: 210px">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in salidas)
                    {
                        <tr>
                            <td>@s.Id</td>
                            <td class="text-nowrap">@s.Fecha</td>
                            <td>
                                <div class="text-truncate" style="max-width: 320px" title="@s.EStablecimiento.Nombre">@s.EStablecimiento.Nombre</div>
                            </td>
                            <td>
                                <div class="text-truncate" style="max-width: 520px" title="@s.Observacion">@s.Observacion</div>
                            </td>
                            <td class="text-nowrap">
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => VerSalida(s.Id)">Ver</button>
                                <button class="btn btn-outline-primary btn-sm ms-1" @onclick='() => Nav.NavigateTo($"/salidas/editar/{s.Id}")'>Editar</button>
                                <button class="btn btn-danger btn-sm ms-1" @onclick="() => Eliminar(s.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile (xs/sm) -->
    <div class="d-md-none">
        @foreach (var s in salidas)
        {
            <div class="card-section p-3 mb-2">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="fw-semibold">Salida #@s.Id</div>
                        <div class="text-muted small">@s.Fecha</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => VerSalida(s.Id)">Ver</button>
                        <button class="btn btn-outline-primary btn-sm" @onclick='() => Nav.NavigateTo($"/salidas/editar/{s.Id}")'>Editar</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(s.Id)">Eliminar</button>
                    </div>
                </div>

                <div class="mt-2">
                    <div class="small fw-semibold">Establecimiento</div>
                    <div class="small">@s.EStablecimiento.Nombre</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(s.Observacion))
                {
                    <div class="mt-2">
                        <div class="small fw-semibold">Observación</div>
                        <div class="small">@s.Observacion</div>
                    </div>
                }
            </div>
        }
    </div>

    @if (MostrarModal && SalidaSeleccionada != null)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            Salida Nº @SalidaSeleccionada.Id
                        </h5>
                        <button class="btn-close" @onclick="CerrarModal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="container-fluid">
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <strong>N° Salida</strong>
                                    <div>@SalidaSeleccionada.Id</div>
                                </div>

                                <div class="col-md-4">
                                    <strong>Fecha</strong>
                                    <div>@SalidaSeleccionada.Fecha.ToString("dd/MM/yyyy")</div>
                                </div>

                                <div class="col-md-4">
                                    <strong>Establecimiento</strong>
                                    <div>@SalidaSeleccionada.EStablecimiento.Nombre</div>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong>Solicitante</strong>
                                    <div>@SalidaSeleccionada.Solicitante</div>
                                </div>
                            </div>

                            <hr />

                            <h6 class="mb-2">Detalle de productos</h6>
                            <table class="table table-sm table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-center">Cantidad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in SalidaSeleccionada.DetalleSalida)
                                    {
                                        <tr>
                                            <td>@d.Producto.Nombre</td>
                                            <td class="text-center">@d.Cantidad</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="mt-3">
                                <strong>Observaciones</strong>
                                <div class="border rounded p-2 bg-light">
                                    @SalidaSeleccionada.Observacion
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <a class="btn btn-primary" target="_blank" href="@($"/reports/salidas/{SalidaSeleccionada.Id}.pdf")">PDF</a>
                        <button class="btn btn-secondary" @onclick="CerrarModal">Cerrar</button>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @if (MostrarConfirmEliminar)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirmar eliminación</h5>
                        <button class="btn-close" @onclick="CancelarEliminar"></button>
                    </div>
                    <div class="modal-body">
                        ¿Eliminar la salida #@IdEliminar?
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                        <button class="btn btn-danger" @onclick="ConfirmarEliminar">Eliminar</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
}

@code {
    private List<Salida>? salidas;
    private bool MostrarModal;
    private Salida? SalidaSeleccionada;
    private bool MostrarConfirmEliminar;
    private long IdEliminar;

    protected override async Task OnInitializedAsync()
    {
        salidas = await SalidaService.GetAllAsync();
    }

    private void Nuevo() => Nav.NavigateTo("/salidas/nuevo");

    private Task Eliminar(long id)
    {
        IdEliminar = id;
        MostrarConfirmEliminar = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmarEliminar()
    {
        var id = IdEliminar;
        MostrarConfirmEliminar = false;

        var eliminado = await SalidaService.DeleteAsync(id);
        if (!eliminado)
            return;

        if (SalidaSeleccionada?.Id == id)
        {
            MostrarModal = false;
            SalidaSeleccionada = null;
        }

        salidas = await SalidaService.GetAllAsync();
    }

    private void CancelarEliminar()
    {
        MostrarConfirmEliminar = false;
        IdEliminar = 0;
    }

    private async Task VerSalida(int id)
    {
        SalidaSeleccionada = await SalidaService.GetByIdAsync(id);
        MostrarModal = true;
    }

    private void CerrarModal()
    {
        MostrarModal = false;
        SalidaSeleccionada = null;
    }
}
