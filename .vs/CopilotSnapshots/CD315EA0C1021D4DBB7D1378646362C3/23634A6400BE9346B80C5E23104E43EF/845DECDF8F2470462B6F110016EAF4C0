using Microsoft.EntityFrameworkCore;

namespace BodegaDESAM.Services
{
    public class InventarioProductoDto
    {
        public int IdProducto { get; set; }
        public string NombreProducto { get; set; } = string.Empty;
        public string? Marca { get; set; }
        public long TotalEntradas { get; set; }
        public long TotalSalidas { get; set; }
        public long StockActual { get; set; }
    }

    public class InventarioService
    {
        private readonly IDbContextFactory<PostgresDataContext> _factory;

        public InventarioService(IDbContextFactory<PostgresDataContext> factory)
        {
            _factory = factory;
        }

        public async Task<List<InventarioProductoDto>> GetInventarioActualAsync()
        {
            using var db = _factory.CreateDbContext();

            // 1) Traer totales por producto (SQL simple y seguro ante nulls)
            var entradasPorProducto = await db.DetalleEntrada
                .AsNoTracking()
                .GroupBy(d => d.id_producto)
                .Select(g => new
                {
                    IdProducto = g.Key,
                    Total = g.Sum(x => (long?)x.Cantidad) ?? 0L
                })
                .ToDictionaryAsync(x => x.IdProducto, x => x.Total);

            var salidasPorProducto = await db.DetalleSalida
                .AsNoTracking()
                .GroupBy(d => d.id_producto)
                .Select(g => new
                {
                    IdProducto = g.Key,
                    Total = g.Sum(x => (long?)x.Cantidad) ?? 0L
                })
                .ToDictionaryAsync(x => x.IdProducto, x => x.Total);

            // 2) Traer listado de productos (sin joins) y calcular en memoria
            var productos = await db.Producto
                .AsNoTracking()
                .OrderBy(p => p.Nombre)
                .Select(p => new
                {
                    p.Id,
                    p.Nombre,
                    p.id_marca
                })
                .ToListAsync();

            // 3) Traer marcas sólo si existen ids
            var marcaIds = productos
                .Where(p => p.id_marca != null)
                .Select(p => p.id_marca!)
                .Distinct()
                .ToList();

            var marcas = await db.Marca
                .AsNoTracking()
                .Where(m => marcaIds.Contains(m.Id))
                .Select(m => new { m.Id, m.Nombre })
                .ToDictionaryAsync(x => x.Id, x => x.Nombre);

            var result = new List<InventarioProductoDto>(productos.Count);
            foreach (var p in productos)
            {
                var entradas = entradasPorProducto.TryGetValue(p.Id, out var te) ? te : 0L;
                var salidas = salidasPorProducto.TryGetValue(p.Id, out var ts) ? ts : 0L;

                string? marcaNombre = null;
                if (p.id_marca != null && marcas.TryGetValue(p.id_marca, out var mn))
                    marcaNombre = mn;

                result.Add(new InventarioProductoDto
                {
                    IdProducto = p.Id,
                    NombreProducto = p.Nombre,
                    Marca = marcaNombre,
                    TotalEntradas = entradas,
                    TotalSalidas = salidas,
                    StockActual = entradas - salidas
                });
            }

            return result;
        }
    }
}
