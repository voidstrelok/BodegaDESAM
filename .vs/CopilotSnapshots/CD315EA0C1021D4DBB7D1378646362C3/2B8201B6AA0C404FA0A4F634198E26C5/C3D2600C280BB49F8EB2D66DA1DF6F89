@page "/salidas/nuevo"
@page "/salidas/editar/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.AdminOrBodega)]

@using BodegaDESAM.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject SalidaService SalidaService
@inject EstablecimientoService EstablecimientoService
@inject ProductoService ProductoService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<h3 class="page-title mb-3">@Titulo</h3>

<EditForm Model="salida" OnValidSubmit="Guardar" FormName="EditarSalida">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    @if (!string.IsNullOrWhiteSpace(ErrorGuardar))
    {
        <div class="alert alert-danger py-2" role="alert">
            @ErrorGuardar
        </div>
    }

    <div class="card-section p-3 mb-3">
        <div class="row g-3">
            <div class="col-12 col-md-3">
                <label class="form-label">Fecha</label>
                <InputDate class="form-control" @bind-Value="salida.Fecha" />
            </div>

            <div class="col-12 col-md-5">
                <label class="form-label">Establecimiento</label>
                <InputSelect class="form-select" @bind-Value="salida.id_establecimiento">
                    <option value="0">-- Seleccionar Establecimiento --</option>
                    @foreach (var e in establecimientos)
                    {
                        <option value="@e.Id">@e.Nombre</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => salida.id_establecimiento" class="text-danger" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label">Solicitante</label>
                <InputText class="form-control" @bind-Value="salida.Solicitante" />
                <ValidationMessage For="() => salida.Solicitante" class="text-danger" />
            </div>

            <div class="col-12">
                <label class="form-label">Observaciones</label>
                <InputText class="form-control" @bind-Value="salida.Observacion" />
                <ValidationMessage For="() => salida.Observacion" class="text-danger" />
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
        <h6 class="m-0">Detalle</h6>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AgregarProducto">Agregar Producto</button>
    </div>

    <div class="card-section p-2 mb-3">
        <table class="table table-sm table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in salida.DetalleSalida)
            {
                <tr>
                    <td>
                        <InputSelect class="form-select" @bind-Value="d.id_producto">
                            <option value="0">-- Seleccionar Producto --</option>
                            @foreach (var p in productos)
                            {
                                <option value="@p.Id">@p.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => d.id_producto" class="text-danger" />
                    </td>
                    <td>
                        <InputNumber class="form-control" @bind-Value="d.Cantidad" />
                        <ValidationMessage For="() => d.Cantidad" class="text-danger" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => EliminarProducto(d)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
        </table>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="button" class="btn btn-secondary" @onclick="Volver">Cancelar</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    [SupplyParameterFromForm]
    private Salida salida { get; set; } = new() { Fecha = DateOnly.FromDateTime(DateTime.Now) };

    private List<Establecimiento> establecimientos { get; set; } = new();
    private List<Producto> productos { get; set; } = new();

    private string Titulo { get; set; } = "Nueva Salida";

    private string? ErrorGuardar;

    protected override async Task OnInitializedAsync()
    {
        establecimientos = await EstablecimientoService.GetAllAsync();
        productos = await ProductoService.GetAllAsync();

        if (Id != null)
        {
            var existente = await SalidaService.GetByIdAsync(Id.Value);
            if (existente != null)
            {
                salida = existente;
                Titulo = $"Editar Salida > {salida.Id}";
            }
        }
    }

    private async Task Guardar()
    {
        ErrorGuardar = null;

        if (salida.DetalleSalida.Count == 0)
        {
            ErrorGuardar = "Debe agregar al menos un producto al detalle.";
            return;
        }

        try
        {
            if (Id == null)
            {
                var auth = await AuthStateProvider.GetAuthenticationStateAsync();
                var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
                await SalidaService.CreateAsync(salida, userId ?? string.Empty);
            }
            else
            {
                await SalidaService.UpdateAsync(salida);
            }

            Nav.NavigateTo("/salidas");
        }
        catch (Exception ex)
        {
            ErrorGuardar = ex.Message;
        }
    }

    private void AgregarProducto()
    {
        ErrorGuardar = null;
        salida.DetalleSalida.Add(new DetalleSalida());
    }

    private void EliminarProducto(DetalleSalida d)
    {
        ErrorGuardar = null;
        salida.DetalleSalida.Remove(d);
    }

    private void Volver() => Nav.NavigateTo("/salidas");
}
