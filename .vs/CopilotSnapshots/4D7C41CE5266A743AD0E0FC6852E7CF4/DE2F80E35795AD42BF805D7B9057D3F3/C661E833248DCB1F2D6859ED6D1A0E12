using Microsoft.EntityFrameworkCore;

namespace BodegaDESAM.Services
{
    public class InventarioProductoDto
    {
        public int IdProducto { get; set; }
        public long IdMarca { get; set; }
        public string NombreProducto { get; set; } = string.Empty;
        public string? Marca { get; set; }
        public string? Categoria { get; set; }
        public long TotalEntradas { get; set; }
        public long TotalSalidas { get; set; }
        public long StockActual { get; set; }
    }

    public class InventarioService
    {
        private readonly IDbContextFactory<PostgresDataContext> _factory;

        public InventarioService(IDbContextFactory<PostgresDataContext> factory)
        {
            _factory = factory;
        }

        public async Task<List<InventarioProductoDto>> GetInventarioActualAsync()
        {
            using var db = _factory.CreateDbContext();

            // Agrupar entradas por producto + marca
            var entradasPorProductoMarca = await db.DetalleEntrada
                .AsNoTracking()
                .GroupBy(d => new { d.id_producto, d.id_marca })
                .Select(g => new
                {
                    g.Key.id_producto,
                    g.Key.id_marca,
                    Total = g.Sum(x => (long?)x.Cantidad) ?? 0L
                })
                .ToListAsync();

            // Agrupar salidas por producto
            var salidasPorProducto = await db.DetalleSalida
                .AsNoTracking()
                .GroupBy(d => d.id_producto)
                .Select(g => new
                {
                    IdProducto = g.Key,
                    Total = g.Sum(x => (long?)x.Cantidad) ?? 0L
                })
                .ToDictionaryAsync(x => x.IdProducto, x => x.Total);

            // Obtener información de productos
            var productosIds = entradasPorProductoMarca.Select(e => e.id_producto).Distinct().ToList();
            var productos = await db.Producto
                .AsNoTracking()
                .Where(p => productosIds.Contains(p.Id))
                .Select(p => new { p.Id, p.Nombre, p.id_categoria_producto })
                .ToDictionaryAsync(x => x.Id, x => x);

            // Obtener marcas
            var marcaIds = entradasPorProductoMarca.Select(e => e.id_marca).Distinct().ToList();
            var marcas = await db.Marca
                .AsNoTracking()
                .Where(m => marcaIds.Contains(m.Id))
                .Select(m => new { m.Id, m.Nombre })
                .ToDictionaryAsync(x => x.Id, x => x.Nombre);

            // Obtener categorías
            var categoriaIds = productos.Values.Select(p => p.id_categoria_producto).Distinct().ToList();
            var categorias = await db.CategoriaProducto
                .AsNoTracking()
                .Where(c => categoriaIds.Contains(c.Id))
                .Select(c => new { c.Id, c.Nombre })
                .ToDictionaryAsync(x => x.Id, x => x.Nombre);

            var result = new List<InventarioProductoDto>();
            
            foreach (var entrada in entradasPorProductoMarca)
            {
                if (!productos.TryGetValue(entrada.id_producto, out var producto))
                    continue;

                var salidas = salidasPorProducto.TryGetValue(entrada.id_producto, out var ts) ? ts : 0L;
                var stock = entrada.Total - salidas;

                string? marcaNombre = marcas.TryGetValue(entrada.id_marca, out var mn) ? mn : null;
                string? categoriaNombre = categorias.TryGetValue(producto.id_categoria_producto, out var cn) ? cn : null;

                result.Add(new InventarioProductoDto
                {
                    IdProducto = entrada.id_producto,
                    IdMarca = entrada.id_marca,
                    NombreProducto = producto.Nombre,
                    Marca = marcaNombre,
                    Categoria = categoriaNombre,
                    TotalEntradas = entrada.Total,
                    TotalSalidas = salidas,
                    StockActual = stock
                });
            }

            return result.OrderBy(i => i.NombreProducto).ThenBy(i => i.Marca).ToList();
        }
    }
}
