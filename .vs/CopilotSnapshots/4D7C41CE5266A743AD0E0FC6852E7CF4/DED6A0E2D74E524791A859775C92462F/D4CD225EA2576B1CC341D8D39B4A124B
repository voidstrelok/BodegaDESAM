using System;
using System.Collections.Generic;
using System.ComponentModel.DataAnnotations;

namespace BodegaDESAM
{
    /// <summary>
    /// Representa un lote de productos para trazabilidad FEFO y recall
    /// Un lote pertenece a un único producto
    /// </summary>
    public partial class Lote
    {
        public long Id { get; set; }

        [Required(ErrorMessage = "Debe seleccionar un producto")]
        [Range(1, int.MaxValue, ErrorMessage = "Debe seleccionar un producto")]
        public int id_producto { get; set; }

        [Required(ErrorMessage = "El código de lote es obligatorio")]
        [StringLength(50, ErrorMessage = "El código debe tener máximo 50 caracteres")]
        public string Codigo { get; set; } = string.Empty;

        public DateOnly? FechaFabricacion { get; set; }

        public DateOnly? FechaVencimiento { get; set; }

        [StringLength(200, ErrorMessage = "Las observaciones deben tener máximo 200 caracteres")]
        public string? Observaciones { get; set; }

        public virtual Producto Producto { get; set; } = null!;
        public virtual ICollection<DetalleEntrada> DetalleEntradas { get; set; } = new HashSet<DetalleEntrada>();
        public virtual ICollection<DetalleSalida> DetalleSalidas { get; set; } = new HashSet<DetalleSalida>();
    }
}
