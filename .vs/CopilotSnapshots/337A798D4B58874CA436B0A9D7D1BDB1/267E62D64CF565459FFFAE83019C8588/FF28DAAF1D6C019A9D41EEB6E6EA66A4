@using BodegaDESAM

<div class="border rounded p-2 mb-2 position-relative">
    <button type="button" class="btn-close position-absolute top-0 end-0 m-1"
            @onclick="OnRemove" title="Quitar ítem"></button>

    <div class="row g-2">
        <div class="col-12 col-md-4">
            <label class="form-label form-label-sm">Producto</label>
            <select class="form-select form-select-sm" @bind="Item.id_producto">
                <option value="0">-- Seleccione --</option>
                @foreach (var p in Productos)
                {
                    <option value="@p.Id">@p.Nombre</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label form-label-sm">Marca</label>
            <select class="form-select form-select-sm" @bind="Item.id_marca">
                <option value="0">-- Seleccione --</option>
                @foreach (var m in Marcas)
                {
                    <option value="@m.Id">@m.Nombre</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label form-label-sm">Tipo</label>
            <select class="form-select form-select-sm" @bind="Item.TipoAjuste" @bind:after="OnTipoAjusteChanged">
                <option value="@TipoAjuste.Aumento">Aumento</option>
                <option value="@TipoAjuste.Disminucion">Disminución</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label form-label-sm">Cantidad</label>
            <input type="number" class="form-control form-control-sm" min="1" @bind="Item.Cantidad" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label form-label-sm">Observación</label>
            <input type="text" class="form-control form-control-sm" @bind="Item.Observacion" />
        </div>

        @if (Item.TipoAjuste == TipoAjuste.Aumento)
        {
            <div class="col-6 col-md-3">
                <label class="form-label form-label-sm">Fecha Vencimiento</label>
                <input type="date" class="form-control form-control-sm"
                       value="@(Item.FechaVencimiento?.ToString("yyyy-MM-dd") ?? "")"
                       @onchange="OnFechaVencimientoChanged" />
            </div>
            <div class="col-12 col-md-5">
                <label class="form-label form-label-sm">N° Serie (opcional, uno por línea)</label>
                <textarea class="form-control form-control-sm" rows="3"
                          placeholder="1 serie por línea (dejar vacío si no aplica)"
                          @bind="SerieInput" @bind:event="oninput"
                          @bind:after="NotifySerieChanged"></textarea>
                @if (!string.IsNullOrWhiteSpace(ErrorSerie))
                {
                    <div class="text-danger small mt-1">@ErrorSerie</div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DetalleAjuste Item { get; set; } = null!;
    [Parameter, EditorRequired] public List<Producto> Productos { get; set; } = null!;
    [Parameter, EditorRequired] public List<Marca> Marcas { get; set; } = null!;
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public string SerieInput { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SerieInputChanged { get; set; }
    [Parameter] public string? ErrorSerie { get; set; }

    private void OnFechaVencimientoChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
            Item.FechaVencimiento = d;
        else
            Item.FechaVencimiento = null;
    }

    private void OnTipoAjusteChanged()
    {
        if (Item.TipoAjuste != TipoAjuste.Aumento)
        {
            Item.FechaVencimiento = null;
            SerieInputChanged.InvokeAsync(string.Empty);
        }
    }

    private Task NotifySerieChanged() => SerieInputChanged.InvokeAsync(SerieInput);
}
