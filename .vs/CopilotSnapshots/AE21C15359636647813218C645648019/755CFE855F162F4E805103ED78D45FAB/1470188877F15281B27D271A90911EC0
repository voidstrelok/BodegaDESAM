@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BodegaDESAM.Services.AlertaService AlertaService
@implements IDisposable

<div class="top-row">
    <div class="container-fluid d-flex align-items-center gap-3">
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            <i class="bi bi-box-seam-fill"></i>
            <span>BodegaDESAM</span>
        </a>

        <div class="ms-auto d-flex align-items-center gap-2">
            <button class="navbar-toggler-btn" title="Menú">
                <i class="bi bi-list"></i>
            </button>
        </div>
    </div>
</div>

<input type="checkbox" id="nav-toggle" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav-content">
        <!-- User Profile Section -->
        <AuthorizeView>
            <Authorized Context="userCtx">
                <div class="user-profile">
                    <div class="user-avatar">
                        @GetUserInitials(userCtx.User.Identity?.Name)
                    </div>
                    <div class="user-info">
                        <div class="user-name">
                            @GetUserDisplayName(userCtx.User)
                        </div>
                        <div class="user-role">
                            <i class="bi bi-shield-fill-check"></i>
                            @GetUserRole(userCtx.User)
                        </div>
                    </div>
                </div>
                <div class="nav-divider"></div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="login">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Iniciar Sesión</span>
                    </NavLink>
                </div>
                <div class="nav-divider"></div>
            </NotAuthorized>
        </AuthorizeView>

        <!-- Main Navigation -->
        <AuthorizeView>
            <Authorized Context="authCtx">
                <!-- Dashboard / Inicio -->
                <div class="nav-section">
                    <div class="nav-item">
                        <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                            @if (totalAlertas > 0)
                            {
                                <span class="badge bg-danger ms-auto">@totalAlertas</span>
                            }
                            <i class="bi bi-chevron-right nav-arrow"></i>
                        </NavLink>
                    </div>
                </div>

                <!-- Movimientos Section -->
                <AuthorizeView Roles="@BodegaDESAM.Auth.AppRoles.AdminOrBodega">
                    <Authorized Context="movCtx">
                        <div class="nav-section">
                            <div class="nav-section-header">
                                <i class="bi bi-arrow-left-right"></i>
                                Movimientos
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="entradas">
                                    <i class="bi bi-box-arrow-in-down-left"></i>
                                    <span>Entradas</span>
                                    <i class="bi bi-chevron-right nav-arrow"></i>
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="salidas">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                    <span>Salidas</span>
                                    <i class="bi bi-chevron-right nav-arrow"></i>
                                </NavLink>
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <!-- Maestros Section -->
                <AuthorizeView Roles="@BodegaDESAM.Auth.AppRoles.Admin">
                    <Authorized Context="adminCtx">
                        <div class="nav-section">
                            <div class="nav-section-header">
                                <i class="bi bi-database"></i>
                                Catálogos
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="productos">
                                    <i class="bi bi-box"></i>
                                    <span>Productos</span>
                                    <i class="bi bi-chevron-right nav-arrow"></i>
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="categorias-producto">
                                    <i class="bi bi-tags"></i>
                                    <span>Categorías</span>
                                    <i class="bi bi-chevron-right nav-arrow"></i>
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="marcas">
                                    <i class="bi bi-award"></i>
                                    <span>Marcas</span>
                                    <i class="bi bi-chevron-right nav-arrow"></i>
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="modelos">
                                    <i class="bi bi-layers"></i>
                                    <span>Modelos</span>
                                    <i class="bi bi-chevron-right nav-arrow"></i>
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="proveedores">
                                    <i class="bi bi-truck"></i>
                                    <span>Proveedores</span>
                                    <i class="bi bi-chevron-right nav-arrow"></i>
                                </NavLink>
                            </div>
                        </div>

                        <!-- Admin Section -->
                        <div class="nav-section">
                            <div class="nav-section-header">
                                <i class="bi bi-gear"></i>
                                Administración
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/usuarios">
                                    <i class="bi bi-people"></i>
                                    <span>Usuarios</span>
                                    <i class="bi bi-chevron-right nav-arrow"></i>
                                </NavLink>
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <!-- Logout Section -->
                <div class="nav-section mt-auto">
                    <div class="nav-item">
                        <NavLink class="nav-link nav-link-danger" href="logout">
                            <i class="bi bi-box-arrow-left"></i>
                            <span>Cerrar Sesión</span>
                        </NavLink>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private int totalAlertas;

    public void Dispose() { }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (auth.User.Identity?.IsAuthenticated == true)
            {
                var alertas = await AlertaService.GetAlertasActivasAsync();
                totalAlertas = alertas.Count;
            }
        }
        catch { }
    }

    private string GetUserDisplayName(System.Security.Claims.ClaimsPrincipal user)
    {
        var name = user.FindFirst("given_name")?.Value;
        if (!string.IsNullOrWhiteSpace(name))
            return name;

        var email = user.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(email))
        {
            // Extract name before @
            var atIndex = email.IndexOf('@');
            return atIndex > 0 ? email.Substring(0, atIndex) : email;
        }

        return "Usuario";
    }

    private string GetUserInitials(string? userName)
    {
        if (string.IsNullOrWhiteSpace(userName))
            return "U";

        var atIndex = userName.IndexOf('@');
        var name = atIndex > 0 ? userName.Substring(0, atIndex) : userName;

        var parts = name.Split(new[] { '.', '_', '-', ' ' }, StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return name.Length >= 2 ? name.Substring(0, 2).ToUpper() : name.ToUpper();
    }

    private string GetUserRole(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole(BodegaDESAM.Auth.AppRoles.Admin))
            return "Administrador";
        if (user.IsInRole(BodegaDESAM.Auth.AppRoles.Bodega))
            return "Bodeguero";
        if (user.IsInRole(BodegaDESAM.Auth.AppRoles.Lectura))
            return "Lectura";

        return "Usuario";
    }
}

