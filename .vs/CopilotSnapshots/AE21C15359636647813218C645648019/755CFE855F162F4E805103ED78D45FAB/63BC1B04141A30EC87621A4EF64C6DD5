@page "/inventario"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using BodegaDESAM.Services
@inject InventarioService InventarioService
@inject InventarioDetalleService InventarioDetalleService
@inject EstablecimientoService EstablecimientoService
@inject NavigationManager Nav

<h3 class="page-title mb-3">Inventario actual</h3>

<div class="page-toolbar">
    <div class="d-flex gap-2 flex-wrap">
        <div class="input-group input-group-sm" style="max-width: 420px;">
            <span class="input-group-text">
                <i class="bi bi-search"></i>
            </span>
            <input class="form-control" placeholder="Buscar producto o marca..." @bind="Filtro" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(Filtro))
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarFiltro">Limpiar</button>
            }
        </div>

        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="soloConStock" @bind="SoloConStock" />
            <label class="form-check-label" for="soloConStock">Solo con stock</label>
        </div>

        <div class="input-group input-group-sm" style="max-width: 340px;">
            <span class="input-group-text">Categoría</span>
            <select class="form-select" @bind="CategoriaFiltro">
                <option value="">-- Todas --</option>
                @foreach (var c in CategoriasDisponibles)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
    </div>

    <div class="text-muted small">
        @if (items != null)
        {
            <span>Productos: @Filtrados.Count</span>
        }
    </div>
</div>

@if (items == null)
{
    <p>Cargando...</p>
}
else if (items.Count == 0)
{
    <p>No hay productos.</p>
}
else
{
    <div class="card-section p-2">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Categoría</th>
                <th class="text-end">Entradas</th>
                <th class="text-end">Salidas</th>
                <th class="text-end">Stock</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Filtrados)
            {
                <tr>
                    <td>@i.NombreProducto</td>
                    <td>@i.Marca</td>
                    <td>@(i.Modelo ?? "-")</td>
                    <td>@i.Categoria</td>
                    <td class="text-end">@i.TotalEntradas</td>
                    <td class="text-end">@i.TotalSalidas</td>
                    <td class="text-end">@i.StockActual</td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => VerMovimientos(i.IdProducto)">Movimientos</button>
                    </td>
                </tr>
            }
        </tbody>
            </table>
        </div>
    </div>

    @if (MostrarModal && ProductoSeleccionado != null)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Movimientos: @ProductoSeleccionado.NombreProducto</h5>
                        <button class="btn-close" @onclick="CerrarModal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="d-flex gap-2 flex-wrap mb-2">
                            <div class="input-group input-group-sm" style="max-width: 300px;">
                                <span class="input-group-text">N° Serie</span>
                                <input class="form-control" placeholder="Buscar serie..." @bind="SerieFiltro" @bind:event="oninput" />
                            </div>

                            <div class="input-group input-group-sm" style="max-width: 360px;">
                                <span class="input-group-text">Establecimiento</span>
                                <select class="form-select" @bind="EstablecimientoFiltro">
                                    <option value="">-- Todos --</option>
                                    @foreach (var e in Establecimientos)
                                    {
                                        <option value="@e.Id">@e.Nombre</option>
                                    }
                                </select>
                            </div>

                            <button class="btn btn-outline-secondary btn-sm" @onclick="AplicarFiltrosMovimientos">Aplicar</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="LimpiarFiltrosMovimientos">Limpiar</button>
                        </div>

                        @if (Movimientos == null)
                        {
                            <div class="text-muted">Cargando...</div>
                        }
                        else if (Movimientos.Count == 0)
                        {
                            <div class="text-muted">Sin movimientos.</div>
                        }
                        else
                        {
                            <table class="table table-sm table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tipo</th>
                                        <th>N°</th>
                                        <th>Fecha</th>
                                        <th>Referencia</th>
                                        <th>Establecimiento</th>
                                        <th>Series</th>
                                        <th class="text-end">Cantidad</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in Movimientos)
                                    {
                                        <tr>
                                            <td>@m.Tipo</td>
                                            <td>@m.IdDocumento</td>
                                            <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td>@m.Referencia</td>
                                            <td>@m.Establecimiento</td>
                                            <td>
                                                @if (m.Series.Count == 0)
                                                {
                                                    <span class="text-muted small">(sin serie)</span>
                                                }
                                                else
                                                {
                                                    <div class="small text-break">@string.Join(", ", m.Series)</div>
                                                }
                                            </td>
                                            <td class="text-end">@m.Cantidad</td>
                                            <td class="text-end text-nowrap">
                                                @if (m.Tipo == "Entrada")
                                                {
                                                    <button class="btn btn-link btn-sm p-0" @onclick="() => IrADetalleEntrada(m.IdDocumento)">Ver entrada</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-link btn-sm p-0" @onclick="() => IrADetalleSalida(m.IdDocumento)">Ver salida</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CerrarModal">Cerrar</button>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
}

@code {
    private List<InventarioProductoDto>? items;
    private List<Establecimiento> Establecimientos { get; set; } = new();

    private string? Filtro;
    private bool SoloConStock;
    private string? CategoriaFiltro;

    private string? SerieFiltro;
    private string? EstablecimientoFiltro;

    private bool MostrarModal;
    private InventarioProductoDto? ProductoSeleccionado;
    private List<MovimientoProductoDetalleDto>? Movimientos;

    private List<string> CategoriasDisponibles => (items ?? new())
        .Select(x => x.Categoria)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList()!;

    private List<InventarioProductoDto> Filtrados => (items ?? new())
        .Where(x =>
            (string.IsNullOrWhiteSpace(Filtro)
                || x.NombreProducto.Contains(Filtro, StringComparison.OrdinalIgnoreCase)
                || (x.Marca?.Contains(Filtro, StringComparison.OrdinalIgnoreCase) ?? false))
            && (string.IsNullOrWhiteSpace(CategoriaFiltro) || string.Equals(x.Categoria, CategoriaFiltro, StringComparison.OrdinalIgnoreCase))
            && (!SoloConStock || x.StockActual > 0))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        items = await InventarioService.GetInventarioActualAsync();
        Establecimientos = await EstablecimientoService.GetAllAsync();
    }

    private void LimpiarFiltro() => Filtro = string.Empty;

    private async Task VerMovimientos(int idProducto)
    {
        ProductoSeleccionado = items?.FirstOrDefault(x => x.IdProducto == idProducto);
        MostrarModal = true;
        Movimientos = null;
        await CargarMovimientosAsync(idProducto);
    }

    private async Task CargarMovimientosAsync(int idProducto)
    {
        int? idEst = null;
        if (int.TryParse(EstablecimientoFiltro, out var parsed))
            idEst = parsed;

        Movimientos = await InventarioDetalleService.GetMovimientosDetalleAsync(
            idProducto,
            SerieFiltro,
            idEst);
    }

    private async Task AplicarFiltrosMovimientos()
    {
        if (ProductoSeleccionado == null)
            return;

        await CargarMovimientosAsync(ProductoSeleccionado.IdProducto);
    }

    private async Task LimpiarFiltrosMovimientos()
    {
        SerieFiltro = string.Empty;
        EstablecimientoFiltro = string.Empty;

        if (ProductoSeleccionado == null)
            return;

        await CargarMovimientosAsync(ProductoSeleccionado.IdProducto);
    }

    private void IrADetalleEntrada(int idEntrada)
    {
        CerrarModal();
        Nav.NavigateTo($"/entradas?view={idEntrada}");
    }

    private void IrADetalleSalida(int idSalida)
    {
        CerrarModal();
        Nav.NavigateTo($"/salidas?view={idSalida}");
    }

    private void CerrarModal()
    {
        MostrarModal = false;
        ProductoSeleccionado = null;
        Movimientos = null;
        SerieFiltro = string.Empty;
        EstablecimientoFiltro = string.Empty;
    }
}
