html, body {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background: #f5f7fb;
    color: #111827;
}

/* Evita scroll horizontal por elementos que se desbordan */
body {
    overflow-x: hidden;
}

main > article.content {
    min-height: 100vh;
}

/* Un ancho máximo mejora legibilidad en pantallas grandes */
.content .container-fluid {
    max-width: 1280px;
}

.page-title {
    font-weight: 600;
    letter-spacing: .2px;
}

.page-toolbar {
    display: flex;
    gap: .5rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    margin: .75rem 0 1rem 0;
}

.card-section {
    border: 1px solid rgba(0,0,0,.075);
    border-radius: .75rem;
    background: #fff;
    box-shadow: 0 6px 18px rgba(17, 24, 39, .06);
}

.table thead th {
    white-space: nowrap;
}

@media (max-width: 576px) {
    .table thead th {
        white-space: normal;
        line-height: 1.2;
    }

    .table-sm > :not(caption) > * > * {
        padding: .25rem .35rem;
        font-size: .85rem;
    }

    .table-responsive > .table {
        min-width: 720px;
    }

    .table-responsive .text-truncate {
        white-space: normal;
    }
}

@media (max-width: 640.98px) {
    .table {
        font-size: .9rem;
    }
}

@media (max-width: 640.98px) {
    .card-section {
        overflow-x: visible;
    }
}

.table td, .table th {
    vertical-align: middle;
}

.table .num {
    text-align: end;
    font-variant-numeric: tabular-nums;
}

.modal-backdrop {
    position: fixed;
    inset: 0;
}

a, .btn-link {
    color: #006bb7;
}

:focus-visible {
    outline: 2px solid #258cfb;
    outline-offset: 2px;
}

.btn-primary {
    color: #fff;
    background-color: #1b6ec2;
    border-color: #1861ac;
}

.btn:focus, .btn:active:focus, .btn-link.nav-link:focus, .form-control:focus, .form-check-input:focus {
  box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem #258cfb;
}

.content {
    padding-top: 1.1rem;
}

@media (max-width: 640.98px) {
    .content {
        padding-top: .75rem;
    }

    main > article.content {
        padding-left: 1rem !important;
        padding-right: 1rem !important;
    }
}

h1:focus {
    outline: none;
}

.valid.modified:not([type=checkbox]) {
    outline: 1px solid #26b050;
}

.invalid {
    outline: 1px solid #e50000;
}

.validation-message {
    color: #e50000;
    font-size: .875rem;
    margin-top: .25rem;
}

/* Alineado a Bootstrap: resalta inputs inválidos (incluyendo Blazor) */
.invalid,
.invalid.modified:not([type=checkbox]) {
    outline: none;
}

.invalid.modified:not([type=checkbox]),
.invalid {
    border-color: #dc3545 !important;
}

.blazor-error-boundary {
    background: url(data:image/svg+xml;base64,) no-repeat 1rem/1.8rem, #b32121;
    padding: 1rem 1rem 1rem 3.7rem;
    color: white;
}

    .blazor-error-boundary::after {
        content: "An error has occurred."
    }

.darker-border-checkbox.form-check-input {
    border-color: #929292;
}
