/* ============================================
   TOP ROW - HEADER
   ============================================ */

.top-row {
    height: 4rem;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0 1.25rem;
}

.top-row .container-fluid {
    height: 100%;
}

/* ============================================
   NAVBAR BRAND (LOGO)
   ============================================ */

.navbar-brand {
    font-size: 1.25rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: all 0.2s ease;
    padding: 0;
}

.navbar-brand i {
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.9);
}

.navbar-brand:hover {
    color: #fff;
    transform: translateX(2px);
}

.navbar-brand:hover i {
    color: #fff;
    transform: scale(1.05);
}

/* ============================================
   THEME TOGGLE BUTTON
   ============================================ */

.theme-toggle {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.9);
    border-radius: 0.5rem;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}

.theme-toggle:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.3);
    transform: scale(1.05);
}

.theme-toggle i {
    font-size: 1.125rem;
}

/* ============================================
   MOBILE TOGGLE BUTTON
   ============================================ */

.navbar-toggler-btn {
    display: none;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.9);
    border-radius: 0.5rem;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
    align-items: center;
    justify-content: center;
}

.navbar-toggler-btn:hover {
    background: rgba(255, 255, 255, 0.2);
}

.navbar-toggler-btn i {
    font-size: 1.5rem;
}

.navbar-toggler {
    display: none;
}

@media (max-width: 640.98px) {
    .navbar-toggler-btn {
        display: flex;
    }

    .top-row {
        padding: 0 1rem;
    }
}

/* ============================================
   NAV SCROLLABLE CONTAINER
   ============================================ */

.nav-scrollable {
    background: var(--sidebar-bg);
    border-right: 1px solid var(--sidebar-border);
    box-shadow: var(--shadow-lg);
    height: calc(100vh - 4rem);
    overflow-y: auto;
    overflow-x: hidden;
}

.nav-scrollable::-webkit-scrollbar {
    width: 6px;
}

.nav-scrollable::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.03);
}

.nav-scrollable::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
}

.nav-scrollable::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.25);
}

/* ============================================
   NAV CONTENT
   ============================================ */

.nav-content {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 1rem 0.75rem 1.5rem;
    gap: 0.25rem;
}

/* ============================================
   USER PROFILE SECTION
   ============================================ */

.user-profile {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    margin-bottom: 0.5rem;
}

.user-avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
    color: white;
    letter-spacing: 0.02em;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

.user-info {
    flex: 1;
    min-width: 0;
}

.user-name {
    color: rgba(255, 255, 255, 0.95);
    font-weight: 600;
    font-size: 0.9375rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 0.125rem;
}

.user-role {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.375rem;
}

.user-role i {
    font-size: 0.875rem;
}

/* ============================================
   NAV DIVIDER
   ============================================ */

.nav-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 0.75rem 0;
}

/* ============================================
   NAV SECTIONS
   ============================================ */

.nav-section {
    margin-bottom: 1rem;
}

.nav-section:last-child {
    margin-bottom: 0;
}

.nav-section-header {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.5rem 0.75rem 0.375rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.nav-section-header i {
    font-size: 0.875rem;
}

/* ============================================
   NAV ITEMS & LINKS
   ============================================ */

.nav-item {
    margin-bottom: 0.25rem;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    border-radius: 0.625rem;
    transition: all 0.2s ease;
    font-size: 0.9375rem;
    font-weight: 500;
    position: relative;
    border: 1px solid transparent;
}

.nav-link i:first-child {
    font-size: 1.125rem;
    width: 1.25rem;
    text-align: center;
    opacity: 0.95;
}

.nav-link span {
    flex: 1;
}

.nav-arrow {
    font-size: 0.75rem;
    opacity: 0;
    transition: all 0.2s ease;
    margin-left: auto;
}

.nav-link:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
    color: #fff;
    transform: translateX(2px);
}

.nav-link:hover .nav-arrow {
    opacity: 0.7;
}

.nav-link.active {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.35), rgba(139, 92, 246, 0.3));
    border-color: rgba(99, 102, 241, 0.5);
    color: #fff;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
}

.nav-link.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 60%;
    background: linear-gradient(180deg, #6366f1, #8b5cf6);
    border-radius: 0 2px 2px 0;
}

.nav-link.active .nav-arrow {
    opacity: 1;
}

.nav-link.active:hover {
    transform: translateX(0);
}

/* Danger link (logout) */
.nav-link-danger {
    color: rgba(239, 68, 68, 0.9);
}

.nav-link-danger:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.3);
    color: #ef4444;
}

.nav-link-danger i {
    color: rgba(239, 68, 68, 0.9);
}

/* ============================================
   MOBILE RESPONSIVE
   ============================================ */

@media (max-width: 640.98px) {
    .nav-scrollable {
        position: fixed;
        top: 4rem;
        left: 0;
        width: 100%;
        height: calc(100vh - 4rem);
        z-index: 99;
        transform: translateX(-100%);
        transition: transform 0.3s ease;
    }

    #nav-toggle:checked ~ .nav-scrollable {
        transform: translateX(0);
    }

    .navbar-toggler-btn {
        display: flex;
    }
}

@media (min-width: 641px) {
    .navbar-toggler-btn {
        display: none;
    }
}

/* ============================================
   ACCESSIBILITY
   ============================================ */

@media (prefers-reduced-motion: reduce) {
    .nav-link,
    .theme-toggle,
    .navbar-brand,
    .navbar-toggler-btn,
    .nav-scrollable {
        transition: none;
    }
}

/* ============================================
   FOCUS STYLES
   ============================================ */

.nav-link:focus-visible,
.theme-toggle:focus-visible,
.navbar-toggler-btn:focus-visible {
    outline: 2px solid rgba(99, 102, 241, 0.8);
    outline-offset: 2px;
}

/* ============================================
   UTILITIES
   ============================================ */

.mt-auto {
    margin-top: auto !important;
}
