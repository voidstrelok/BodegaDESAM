            <button class="theme-toggle" @onclick="ToggleTheme" title="Cambiar tema">
                <i class="bi @(isDarkMode ? "bi-sun-fill" : "bi-moon-fill")"></i>
            </button>
            <button class="navbar-toggler-btn" title="Menú">
