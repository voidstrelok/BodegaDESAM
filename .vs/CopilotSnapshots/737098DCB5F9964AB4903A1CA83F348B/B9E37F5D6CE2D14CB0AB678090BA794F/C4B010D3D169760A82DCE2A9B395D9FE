                            </div>
                        </div>

                        <!-- Admin Section -->
                        <div class="nav-section">
                            <div class="nav-section-header">
                                <i class="bi bi-gear"></i>
                                Administración
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/usuarios">
                                    <i class="bi bi-people"></i>
                                    <span>Usuarios</span>
                                    <i class="bi bi-chevron-right nav-arrow"></i>
                                </NavLink>
