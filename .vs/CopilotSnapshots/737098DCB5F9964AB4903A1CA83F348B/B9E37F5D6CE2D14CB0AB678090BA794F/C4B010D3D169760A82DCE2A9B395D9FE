                </AuthorizeView>

                <!-- Logout Section -->
                <div class="nav-section mt-auto">
                    <div class="nav-item">
                        <NavLink class="nav-link nav-link-danger" href="logout">
                            <i class="bi bi-box-arrow-left"></i>
                            <span>Cerrar Sesión</span>
                        </NavLink>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool isDarkMode = false;

    protected override void OnInitialized()
    {
        // Suscribirse a cambios de tema
        ThemeService.OnThemeChanged += OnThemeChangedHandler;
        isDarkMode = ThemeService.IsDarkMode;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Sincronizar con localStorage al cargar
                var currentTheme = await JS.InvokeAsync<bool>("isDarkMode");
                ThemeService.SetDarkMode(currentTheme);
                isDarkMode = currentTheme;
                StateHasChanged();
            }
            catch
            {
                // JS no disponible aún
            }
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            isDarkMode = !isDarkMode;
            ThemeService.SetDarkMode(isDarkMode);
            await JS.InvokeVoidAsync("toggleTheme");
        }
        catch (Exception ex)
        {
            // Si falla, revertir
            isDarkMode = !isDarkMode;
            ThemeService.SetDarkMode(isDarkMode);
            Console.WriteLine($"Error al cambiar tema: {ex.Message}");
        }
    }

    private void OnThemeChangedHandler()
    {
        isDarkMode = ThemeService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChangedHandler;
    }

    private string GetUserDisplayName(System.Security.Claims.ClaimsPrincipal user)
    {
        var name = user.FindFirst("given_name")?.Value;
        if (!string.IsNullOrWhiteSpace(name))
            return name;

        var email = user.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(email))
        {
            // Extract name before @
            var atIndex = email.IndexOf('@');
            return atIndex > 0 ? email.Substring(0, atIndex) : email;
        }

        return "Usuario";
    }

    private string GetUserInitials(string? userName)
    {
        if (string.IsNullOrWhiteSpace(userName))
            return "U";

        var atIndex = userName.IndexOf('@');
        var name = atIndex > 0 ? userName.Substring(0, atIndex) : userName;

        var parts = name.Split(new[] { '.', '_', '-', ' ' }, StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return name.Length >= 2 ? name.Substring(0, 2).ToUpper() : name.ToUpper();
    }

    private string GetUserRole(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole(BodegaDESAM.Auth.AppRoles.Admin))
            return "Administrador";
        if (user.IsInRole(BodegaDESAM.Auth.AppRoles.Bodega))
            return "Bodeguero";
        if (user.IsInRole(BodegaDESAM.Auth.AppRoles.Lectura))
            return "Lectura";

        return "Usuario";
    }
}

