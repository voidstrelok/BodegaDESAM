@page "/marcas/nuevo"
@page "/marcas/editar/{Id:int}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BodegaDESAM.Auth.AppRoles.Admin)]

@using BodegaDESAM.Services

@inject MarcaService MarcaService
@inject NavigationManager Nav

<h3 class="page-title mb-3">@Titulo</h3>

<EditForm Model="marca" OnValidSubmit="Guardar" FormName="EditarMarca">
    <DataAnnotationsValidator />

    <div class="card-section p-3 mb-3">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label">Nombre</label>
                <InputText class="form-control" @bind-Value="marca.Nombre" />
                <ValidationMessage For="@(() => marca.Nombre)" />
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="button" class="btn btn-secondary" @onclick="Volver">Cancelar</button>
    </div>
</EditForm>

@code {
    [Parameter] 
    public long? Id { get; set; }

    [SupplyParameterFromForm]
    Marca marca { get; set; } = new();

    string Titulo => Id == null ? "Nueva Marca" : "Editar Marca";

    protected override async Task OnInitializedAsync()
    {
        if (Id != null)
        {
            var existente = await MarcaService.GetByIdAsync((long)Id);
            if (existente != null)
                marca = existente;
        }
    }

    async void Guardar()
    {
        if (Id == null)
        {
            await MarcaService.CreateAsync(marca);
        }
        else
            await MarcaService.UpdateAsync(marca);

        Nav.NavigateTo("/marcas");
    }

    void Volver() => Nav.NavigateTo("/marcas");
}